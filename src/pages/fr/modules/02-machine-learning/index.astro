---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSecondary from '@/components/HeroSecondary.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ExecutiveSummary from '@/components/ExecutiveSummary.astro';
import OutcomesList from '@/components/OutcomesList.astro';
import ConceptCard from '@/components/ConceptCard.astro';
import SourceTag from '@/components/SourceTag.astro';
import PitfallList from '@/components/PitfallList.astro';
import CaseCardCompact from '@/components/CaseCardCompact.astro';
import Activity from '@/components/Activity.astro';
import QuizPlaceholder from '@/components/QuizPlaceholder.astro';
import Checklist from '@/components/Checklist.astro';
import KeyTakeaways from '@/components/KeyTakeaways.astro';
import ResourceList from '@/components/ResourceList.astro';
import PrevNextNav from '@/components/PrevNextNav.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import { getLocalizedUrl } from '@/i18n/helpers';
import quizModule2 from '@/content/quizzes/module-2';

const locale = 'fr';

// === TABLE OF CONTENTS ===
const tocItems = [
  { id: 'synthese-executive', label: 'Synthèse exécutive' },
  { id: 'objectifs', label: "Objectifs d'apprentissage" },
  { id: 'concepts', label: 'Concepts clés' },
  { id: 'erreurs-frequentes', label: 'Erreurs fréquentes' },
  { id: 'cas-reel', label: 'Cas réel' },
  { id: 'activite', label: 'Activité pratique' },
  { id: 'quiz', label: 'Quiz formatif' },
  { id: 'checklist', label: 'Checklist manager' },
  { id: 'application', label: 'Application dans votre organisation' },
  { id: 'a-retenir', label: 'À retenir' },
  { id: 'pour-aller-plus-loin', label: 'Pour aller plus loin' },
];

// === LEARNING OUTCOMES ===
const outcomes = [
  "Distinguer apprentissage supervisé, non supervisé et par renforcement, et savoir lequel correspond à un cas d'usage donné.",
  "Reconnaître les conditions de viabilité d'un projet ML : données disponibles, qualité, étiquetage, intégration au workflow.",
  "Comprendre les notions clés de surapprentissage et de généralisation, et leurs implications business pour les décisions de déploiement.",
  "Décider si un cas d'usage ML soutient une stratégie de coût, de différenciation ou de focalisation.",
  "Évaluer en COMEX un dossier ML candidat sur trois dimensions : stratégique, technique, organisationnelle.",
];

// === PITFALLS ===
const pitfalls = [
  {
    title: "Évaluer un projet ML sur la précision du modèle plutôt que sur le ROI réel",
    error:
      "Décider de déployer (ou non) un modèle ML uniquement sur la base de sa précision technique en laboratoire (par exemple « 92 % de précision sur le test set »), sans rapporter cette performance à la valeur business attendue ni au coût total du dispositif.",
    mechanism:
      "La précision technique est facile à mesurer ; la valeur business demande de modéliser le coût d'une erreur, le bénéfice d'une bonne décision, et le coût des actions déclenchées par les prédictions. Sans ce calcul, un modèle 'précis' peut être économiquement inintéressant — et un modèle 'moyennement précis' très rentable.",
    mitigation:
      "Définir avant tout pilote la traduction monétaire d'une bonne et d'une mauvaise prédiction. Calculer le ROI en combinant précision × volume × valeur unitaire − coût total du dispositif. La précision n'est qu'une variable parmi d'autres.",
  },
  {
    title: "Sous-estimer le coût et la complexité de l'étiquetage des données",
    error:
      "Lancer un projet ML supervisé en supposant que les données existantes sont 'déjà étiquetées', alors qu'elles ne le sont pas, ou qu'elles le sont avec une qualité insuffisante (étiquetage incohérent, biaisé, ou partiel).",
    mechanism:
      "Étiqueter les données est un travail lourd, souvent sous-estimé. Pour un dataset de 50 000 exemples sur un sujet expert (médecine, juridique, finance), le coût d'étiquetage peut représenter 30 à 50 % du budget total du projet. Ignorer ce coût mène à des projets qui s'essoufflent dans la phase de préparation des données.",
    mitigation:
      "Auditer la qualité des étiquettes existantes avant de lancer le projet. Budgétiser explicitement la phase d'étiquetage (équipes internes, prestataires spécialisés, plateformes de crowdsourcing). Considérer les approches semi-supervisées ou actives quand les étiquettes sont rares.",
  },
  {
    title: "Confondre corrélation observée et causalité utile en business",
    error:
      "Interpréter les sorties d'un modèle ML comme des causes plutôt que comme des prédictions. Par exemple, prendre une corrélation entre 'achat de pizza congelée' et 'défaut de paiement' pour conclure 'la pizza congelée cause le défaut'.",
    mechanism:
      "Le ML supervisé apprend à prédire, pas à expliquer. Les variables qui prédisent bien peuvent être des proxies de causes réelles (ici : situation économique du foyer), des artefacts d'échantillonnage, ou des biais de mesure. Confondre prédiction et causalité mène à des décisions business erronées et parfois discriminatoires.",
    mitigation:
      "Lire les sorties d'un modèle comme des prédictions, pas comme des explications. Pour comprendre les causes, faire appel à des méthodes dédiées (expérimentation, analyse causale, raisonnement métier). Ne jamais formuler une politique d'entreprise sur la base de corrélations brutes apprises par un modèle.",
  },
  {
    title: "Ignorer le drift des données et l'usure du modèle",
    error:
      "Considérer un modèle ML comme stable une fois mis en production, sans dispositif de surveillance ni cycle de mise à jour. Découvrir des mois plus tard que la performance s'est dégradée silencieusement.",
    mechanism:
      "Les données réelles évoluent : nouveaux comportements clients, changements réglementaires, ruptures de marché (pandémie, inflation). Un modèle entraîné sur l'historique cesse de bien refléter le présent. Cette dérive — data drift, concept drift — peut être lente et invisible sans monitoring.",
    mitigation:
      "Mettre en place dès la phase pilote un dispositif de monitoring continu : suivi des métriques de performance, alertes en cas de dérive des distributions de données, cycle de réentraînement périodique. Prévoir budget et équipe pour le run, pas seulement pour le build.",
  },
];

// === ACTIVITY STEPS ===
const activitySteps = [
  {
    heading: "Décrire le cas d'usage candidat",
    body: "Choisissez un cas d'usage ML candidat dans votre organisation et formulez en une phrase la décision que le système doit prendre. Identifiez le type de problème : classification, régression, clustering, détection d'anomalies. Si la décision n'est pas formulable clairement, le cas n'est pas mûr pour un ML.",
  },
  {
    heading: "Évaluer la qualité des données",
    body: "Notez sur 5 chacune des 4 dimensions de qualité : volume (assez d'observations), étiquetage (sortie attendue connue pour le supervisé), qualité (propres, complètes), représentativité (l'historique reflète bien le futur). Score < 8/20 → ML probablement prématuré.",
  },
  {
    heading: "Cadrer stratégiquement",
    body: "Rattachez le projet à une dimension stratégique (différenciation, leadership de coût, focalisation). Formulez une phrase de défense en 30 secondes. Si la phrase est confuse ou interchangeable d'un projet à l'autre, le cadrage est manquant.",
  },
  {
    heading: "Évaluer valeur et coût total",
    body: "Estimez la valeur business attendue (en €/an ordre de grandeur) et le coût total du projet (modèle + données + intégration + conduite du changement + gouvernance). Calculez le ratio. Si le modèle représente plus de 40 % du coût, l'écosystème est sous-budgétisé.",
  },
];

const activityCriteria = [
  "La décision à prendre par le ML est formulée en une phrase claire.",
  "Le type de problème ML est identifié (supervisé / non supervisé / renforcement) et justifié.",
  "Le score qualité données / 20 est explicite, dimension par dimension.",
  "Le ratio valeur / coût est défendable devant un COMEX en moins de 90 secondes.",
];

// === CHECKLIST GROUPS ===
const checklistGroups = [
  {
    title: "Cadrage technique du cas ML",
    items: [
      "La décision à prendre par le ML est formulée en une phrase claire.",
      "Le type de problème (supervisé / non supervisé / renforcement) est identifié et justifié.",
      "Les données nécessaires sont identifiées : volume, étiquetage, qualité, représentativité.",
      "Une métrique de succès business (€, %, satisfaction) est définie en plus de la métrique technique.",
    ],
  },
  {
    title: "Données et conformité",
    items: [
      "L'audit de biais (sous-groupes : genre, origine, âge, géographie) est prévu en amont du déploiement.",
      "La conformité AI Act EU et RGPD est vérifiée si le cas tombe en 'haut risque' (RH, crédit, justice, santé).",
      "Le coût d'étiquetage est budgétisé explicitement (souvent 30-50 % du budget total pour les sujets experts).",
      "Le dispositif de monitoring du drift et de réentraînement est prévu dès la conception.",
    ],
  },
  {
    title: "Stratégie et gouvernance",
    items: [
      "Le projet est rattaché à une dimension stratégique de Porter (différenciation / coût / focalisation).",
      "La place de l'humain dans la boucle est explicite : qui valide, qui supervise, qui peut reprendre la main.",
      "Le ROI est calculé sur la base de la valeur business attendue, pas seulement de la précision technique.",
      "Le comité de gouvernance IA est désigné, avec rôles, cadence et critères de Go/No-Go définis.",
    ],
  },
];

// === TAKEAWAYS ===
const takeaways = [
  "Le concept clé : trois familles de ML (supervisé, non supervisé, renforcement) répondent à des questions différentes — choisir la bonne famille est déjà la moitié du cadrage.",
  "Le cas exemplaire : Stripe Radar montre comment une infrastructure ML supervisée à très grande échelle protège un acteur central des paiements en ligne, en combinant modèle + retours d'utilisateurs + règles métier.",
  "Le piège majeur : évaluer un projet ML sur la précision plutôt que sur le ROI — la précision technique est nécessaire mais loin d'être suffisante.",
  "L'outil opérationnel : le canvas d'évaluation ML en 4 étapes (décrire / qualifier données / cadrer stratégie / chiffrer valeur et coût) avant tout pilote.",
  "La suite : le Module 3 entre dans l'IA générative en entreprise — autre famille technique, mêmes principes de cadrage.",
];

// === RESOURCES ===
const resources = [
  {
    type: 'video' as const,
    title: 'Introduction to Machine Learning (cours complet)',
    author: 'MIT OpenCourseWare — 6.036',
    description:
      "Le cours d'introduction MIT au ML, gratuit, structuré, accessible aux non-techniciens motivés. Idéal pour solidifier les bases conceptuelles.",
    href: 'https://ocw.mit.edu/courses/6-036-introduction-to-machine-learning-fall-2020/',
    sourceLevel: 'recommended-complement' as const,
  },
  {
    type: 'reading' as const,
    title: 'A primer on machine learning for fraud protection',
    author: 'Stripe',
    description:
      "Guide pédagogique de Stripe sur l'application du ML à la détection de fraude. Disponible en français. Concret, sourcé, écrit par les praticiens.",
    href: 'https://stripe.com/fr-ca/guides/primer-on-machine-learning-for-fraud-protection',
    sourceLevel: 'external-verifiable' as const,
  },
  {
    type: 'reading' as const,
    title: "Comment l'IA améliore le dépistage du cancer du sein",
    author: 'Travaux de Regina Barzilay (MIT CSAIL)',
    description:
      "Recherche MIT sur l'apport du ML au dépistage précoce. Cas exemplaire d'IA en santé : amélioration mesurable, supervision humaine, déploiement progressif.",
    href: 'https://news.mit.edu/topic/artificial-intelligence2',
    sourceLevel: 'recommended-complement' as const,
  },
  {
    type: 'reading' as const,
    title: 'AI Risk Management Framework (AI RMF 1.0)',
    author: 'NIST — National Institute of Standards and Technology',
    description:
      "Cadre opérationnel américain pour la gestion des risques IA, applicable au ML. Référence indispensable pour les responsables gouvernance et conformité.",
    href: 'https://www.nist.gov/itl/ai-risk-management-framework',
    sourceLevel: 'external-verifiable' as const,
  },
  {
    type: 'reading' as const,
    title: 'Règlement (UE) 2024/1689 — AI Act',
    author: "Journal officiel de l'Union européenne",
    description:
      "Texte intégral du règlement européen sur l'IA, en français. Indispensable pour cadrer la conformité des projets ML, notamment pour les cas 'à haut risque' (RH, crédit, justice, santé).",
    href: 'https://eur-lex.europa.eu/legal-content/FR/TXT/PDF/?uri=OJ%3AL_202401689',
    sourceLevel: 'external-verifiable' as const,
  },
  {
    type: 'pdf' as const,
    title: "Canvas d'évaluation d'un cas d'usage ML",
    author: 'AI Strategy — Module 2',
    description:
      "Canvas Markdown imprimable pour structurer l'évaluation d'un cas ML candidat sur 4 dimensions (description, données, stratégie, valeur/coût).",
    href: '/downloads/canvas-evaluation-cas-ml-module-2.md',
    sourceLevel: 'pedagogical-reconstruction' as const,
  },
];

// === URLs ===
const module1Url = getLocalizedUrl('/modules/01-introduction-ia/', locale);
const module3Url = getLocalizedUrl('/modules/03-ia-generative/', locale);
