import IndependenceNotice from '@/components/IndependenceNotice.astro';
import { getLocalizedUrl } from '@/i18n/helpers';
import quizModule3 from '@/content/quizzes/module-3';

const locale = 'fr';

// === TABLE OF CONTENTS ===
const tocItems = [
  { id: 'synthese-executive', label: 'Synthèse exécutive' },
  { id: 'objectifs', label: "Objectifs d'apprentissage" },
  { id: 'concepts', label: 'Concepts clés' },
  { id: 'erreurs-frequentes', label: 'Erreurs fréquentes' },
  { id: 'cas-reel', label: 'Cas réel' },
  { id: 'activite', label: 'Activité pratique' },
  { id: 'quiz', label: 'Quiz formatif' },
  { id: 'checklist', label: 'Checklist manager' },
  { id: 'application', label: 'Application dans votre organisation' },
  { id: 'a-retenir', label: 'À retenir' },
  { id: 'pour-aller-plus-loin', label: 'Pour aller plus loin' },
];

// === LEARNING OUTCOMES ===
const outcomes = [
  "Comprendre ce qu'est un foundation model et pourquoi sa généricité change l'économie des projets IA en entreprise.",
  "Distinguer prompting, fine-tuning et RAG — choisir la bonne approche selon le cas d'usage.",
  "Reconnaître les hallucinations comme caractéristique structurelle des LLM et concevoir les garde-fous correspondants.",
  "Décomposer un workflow métier en sous-tâches pour identifier les candidats GenAI à fort ROI.",
  "Calculer le coût total d'automatisation d'un cas GenAI (modèle + RAG + intégration + supervision) et le rapporter à la valeur business attendue.",
];

// === PITFALLS ===
const pitfalls = [
  {
    title: "Prendre une réponse plausible pour une réponse vraie",
    error:
      "Déployer un assistant GenAI qui répond avec aplomb sur des sujets sensibles (juridique, médical, financier, technique), et constater plus tard que les réponses contenaient des informations inventées (faux articles de loi, fausses citations, faux noms de produits) — sans signal d'alerte pour l'utilisateur.",
    mechanism:
      "Les LLM sont entraînés à produire la suite de texte la plus probable, pas la plus vraie. Ils n'ont pas de mécanisme intrinsèque pour distinguer ce qu'ils savent de ce qu'ils inventent. Une réponse plausible est leur sortie naturelle, qu'elle soit factuelle ou hallucinée.",
    mitigation:
      "Aucun usage à fort enjeu ne peut reposer sur un LLM seul. Garde-fous obligatoires : RAG sur des sources vérifiables et tracées, citation systématique des sources, escalade humaine sur les cas sensibles, validation échantillonnée régulière. Communication claire aux utilisateurs : ce que l'IA peut faire, ce qu'elle ne peut pas faire.",
  },
  {
    title: "Sous-estimer le coût total d'automatisation",
    error:
      "Évaluer le projet GenAI en ne comptant que la souscription au LLM, et découvrir tardivement que l'intégration au système d'information, la construction du RAG, la supervision continue et la conduite du changement représentent l'essentiel du budget réel.",
    mechanism:
      "Les éditeurs et les médias mettent en avant le coût d'inférence (« quelques centimes par requête »), qui est facilement comparable et comparable. Le reste du coût est diffus, organisationnel, et difficile à anticiper sans expérience. Résultat : projets sous-budgétisés qui s'effondrent ou se transforment en POC permanents.",
    mitigation:
      "Découper systématiquement le budget en 6 lignes : modèle/inférence, ingestion/RAG, intégration SI, conduite du changement, supervision, gouvernance. Si la souscription LLM représente plus de 30 % du total, l'écosystème est sous-budgétisé. Prendre en compte les coûts d'inférence à l'échelle (multiplication par le volume réel) — un POC à 1 000 requêtes/mois ne coûte pas 1 000 fois moins qu'une production à 1 000 000.",
  },
  {
    title: "Confondre démo impressionnante et solution opérationnelle",
    error:
      "Décider d'un déploiement GenAI sur la base d'une démonstration spectaculaire (l'éditeur ou un POC interne montre une capacité bluffante sur quelques exemples bien choisis), puis mesurer en production que la qualité varie fortement selon les cas réels, que des cas limites cassent le système, et que les utilisateurs n'adoptent pas.",
    mechanism:
      "Les démos sont conçues pour mettre en valeur les forces. Les cas réels contiennent des particularités (jargon métier, cas limites, données mal structurées, attentes utilisateur spécifiques) qui dégradent la performance. Un système GenAI peut être brillant à 80 % du temps et désastreux sur les 20 % restants — qui sont précisément les cas qui comptent en business.",
    mitigation:
      "Tester les pilotes GenAI sur des cas réels représentatifs, choisis par les utilisateurs métier (pas par l'éditeur ou le data team), incluant des cas limites et des cas à fort enjeu. Mesurer la qualité à l'échelle (échantillon statistiquement représentatif), pas seulement la vitesse ou la satisfaction superficielle. Ne jamais passer en production sur la base d'une démo seule.",
  },
  {
    title: "Casser le pipeline de formation interne",
    error:
      "Supprimer les niveaux juniors d'une fonction métier (analystes, juristes débutants, conseillers premier niveau) en s'appuyant sur GenAI pour traiter leur charge — et constater à 5 ans que l'organisation n'a plus de seniors capables de former la nouvelle génération, ni d'experts capables de superviser intelligemment l'IA.",
    mechanism:
      "Les niveaux juniors apprennent en faisant. Les seniors d'aujourd'hui sont les juniors d'hier. Si GenAI traite ce que faisaient les juniors, le pipeline de formation se rompt — les futures recrues n'ont plus de moyens de monter en compétence, et la connaissance métier s'érode silencieusement. Ce risque est invisible à court terme, dévastateur à long terme.",
    mitigation:
      "Repenser les niveaux juniors comme superviseurs et améliorateurs du système GenAI plutôt que comme exécutants. Conserver des cas réels traités sans GenAI pour la formation. Documenter explicitement les choix métier que l'IA reproduit (sinon perdus). Mesurer la profondeur d'expertise sur 3-5 ans, pas seulement la productivité immédiate.",
  },
];

// === ACTIVITY STEPS ===
const activitySteps = [
  {
    heading: "Décrire le workflow candidat",
    body: "Choisissez un workflow métier candidat à GenAI dans votre organisation. Décomposez-le en 3 à 8 sous-tâches, de la plus mécanique à la plus créative/sensible. Pour chaque sous-tâche, notez le temps actuel et le niveau d'enjeu (1-5). Si la décomposition n'est pas possible, le workflow n'est pas mûr pour un pilote.",
  },
  {
    heading: "Identifier les sous-tâches candidates",
    body: "Pour chaque sous-tâche, posez 3 questions : (1) tâche linguistique ou créative ? (2) connaissance interne nécessaire ? (3) décision à fort enjeu ? Verdict GenAI : automatiser avec RAG / assister l'humain (HITL) / garder humaine / pas un cas GenAI.",
  },
  {
    heading: "Architecturer le pilote",
    body: "Choisissez l'approche technique (prompting simple / RAG / fine-tuning / combinaison). Listez au moins 5 garde-fous indispensables (sources citées, escalade humaine, validation échantillonnée, filtre PII, logs, signalement utilisateur, mise à jour RAG, RGPD, AI Act). Définissez le périmètre (volume, utilisateurs, durée, critère Go/No-Go).",
  },
  {
    heading: "Évaluer coût total et valeur",
    body: "Estimez le coût total du pilote en 6 lignes (modèle/inférence + RAG + intégration + conduite du changement + supervision + gouvernance). Estimez la valeur business attendue (temps gagné, qualité, couverture, risque réduit) en € sur 12 mois. Si la souscription LLM représente plus de 30 % du total, l'écosystème est sous-budgétisé.",
  },
];

const activityCriteria = [
  "Le workflow est décomposé en sous-tâches concrètes (au moins 3, idéalement 5-8).",
  "L'approche technique (prompting / RAG / fine-tuning) est justifiée.",
  "Au moins 5 garde-fous sont prévus dès le pilote.",
  "Le coût total du pilote est chiffré, avec extrapolation production.",
  "La valeur business attendue est chiffrée en € sur 12 mois.",
];

// === CHECKLIST GROUPS ===
const checklistGroups = [
  {
    title: "Cadrage du cas GenAI",
    items: [
      "Le workflow visé est décomposé en sous-tâches concrètes (3 à 8 étapes).",
      "Les sous-tâches à automatiser, à assister, et à garder humaines sont identifiées explicitement.",
      "Le choix entre prompting / RAG / fine-tuning est justifié.",
      "La métrique de succès business (€, temps, qualité) est définie en plus de la métrique technique.",
    ],
  },
  {
    title: "Garde-fous et conformité",
    items: [
      "Les sources sont systématiquement citées dans les réponses (traçabilité).",
      "L'escalade humaine est prévue pour les sous-tâches à fort enjeu.",
      "Les données personnelles dans les prompts et le RAG sont auditées (RGPD).",
      "La conformité AI Act EU est vérifiée si l'usage tombe en haut risque (RH, crédit, justice, santé, éducation).",
    ],
  },
  {
    title: "Économie et organisation",
    items: [
      "Le coût total est découpé en 6 lignes (modèle / RAG / intégration / changement / supervision / gouvernance).",
      "La souscription LLM représente moins de 30 % du budget total.",
      "Les coûts d'inférence à l'échelle (volume réel attendu) sont calculés, pas seulement les coûts du POC.",
      "L'effet sur le pipeline de formation interne (juniors, seniors) est anticipé sur 3-5 ans.",
    ],
  },
];

// === TAKEAWAYS ===
const takeaways = [
  "Le concept clé : les foundation models changent l'économie de l'IA en entreprise — la même base sert des dizaines de cas d'usage, mais demande RAG ou fine-tuning pour vraiment créer de la valeur.",
  "Le cas exemplaire : Morgan Stanley AskResearchGPT et Debrief montrent que la valeur GenAI vient de l'orchestration (LLM + RAG sur la base interne + escalade humaine + gouvernance), pas du modèle seul.",
  "Le piège majeur : prendre une réponse plausible pour une réponse vraie — les hallucinations sont structurelles, pas un bug à corriger. Aucun usage à fort enjeu ne peut reposer sur un LLM seul.",
  "L'outil opérationnel : le brief de pilote GenAI en 4 étapes (workflow / sous-tâches / architecture + garde-fous / coût total et valeur) avant tout déploiement.",
  "La suite : le Module 4 explore la robotique en entreprise — autre famille technologique avec des principes de cadrage similaires (système, ROI, gouvernance).",
];

// === RESOURCES ===
const resources = [
