---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSecondary from '@/components/HeroSecondary.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ExecutiveSummary from '@/components/ExecutiveSummary.astro';
import OutcomesList from '@/components/OutcomesList.astro';
import ConceptCard from '@/components/ConceptCard.astro';
import SourceTag from '@/components/SourceTag.astro';
import PitfallList from '@/components/PitfallList.astro';
import CaseCardCompact from '@/components/CaseCardCompact.astro';
import Activity from '@/components/Activity.astro';
import QuizInteractive from '@/components/QuizInteractive';
import Checklist from '@/components/Checklist.astro';
import KeyTakeaways from '@/components/KeyTakeaways.astro';
import ResourceList from '@/components/ResourceList.astro';
import PrevNextNav from '@/components/PrevNextNav.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import { getLocalizedUrl } from '@/i18n/helpers';
import quizModule6 from '@/content/quizzes/module-6';

const locale = 'fr';

// === TABLE OF CONTENTS ===
const tocItems = [
  { id: 'synthese-executive', label: 'Synthèse exécutive' },
  { id: 'objectifs', label: "Objectifs d'apprentissage" },
  { id: 'concepts', label: 'Concepts clés' },
  { id: 'erreurs-frequentes', label: 'Erreurs fréquentes' },
  { id: 'cas-reel', label: 'Cas réel' },
  { id: 'activite', label: 'Activité pratique' },
  { id: 'quiz', label: 'Quiz formatif' },
  { id: 'checklist', label: 'Checklist manager' },
  { id: 'application', label: 'Application dans votre organisation' },
  { id: 'a-retenir', label: 'À retenir' },
  { id: 'pour-aller-plus-loin', label: 'Pour aller plus loin' },
];

// === LEARNING OUTCOMES ===
const outcomes = [
  "Distinguer prévision (un futur unique) et scenario planning (plusieurs futurs possibles) — choisir l'approche selon le degré d'incertitude.",
  "Distinguer veille technologique (passive) et anticipation stratégique (active) — savoir comment passer de l'une à l'autre.",
  "Comprendre les principales évolutions attendues à 3-10 ans en IA (techniques, réglementaires, sociétales) sans tomber dans la prédiction excessive.",
  "Construire une roadmap IA stratégique structurée en 5 dimensions (vision, use cases prioritaires, gouvernance, compétences et organisation, KPIs).",
  "Hiérarchiser une roadmap IA dans le temps (fondations 0-6 mois, premiers résultats 6-12 mois, ambition élargie 12-24 mois) en respectant les dépendances naturelles.",
];

// === PITFALLS ===
const pitfalls = [
  {
    title: "Prédire un futur unique au lieu de penser plusieurs futurs",
    error:
      "Construire la roadmap IA d'une organisation en supposant qu'un scénario unique va se réaliser (« l'IA générative va dominer dans 18 mois », « l'AI Act va se durcir », « les agents autonomes vont remplacer les analystes »). Engager des investissements lourds qui supposent que ce scénario advienne — et constater à 12-24 mois que la réalité est différente.",
    mechanism:
      "L'avenir de l'IA est intrinsèquement incertain à 3-10 ans : évolutions techniques rapides, réglementations en construction, dynamiques sociales imprévisibles. Tenter de prédire un futur unique est une erreur méthodologique. Les organisations qui s'y engagent prennent des décisions optimisées pour un scénario, fragiles dans les autres.",
    mitigation:
      "Construire 3 scénarios contrastés (continuité accélérée, rupture technologique, resserrement réglementaire et social) et identifier les actions robustes — celles qui sont utiles dans au moins 2 scénarios sur 3. Investir prioritairement dans ces actions robustes. Conserver des options pour les actions dépendantes d'un scénario unique. Réviser les scénarios tous les 6-12 mois.",
  },
  {
    title: "Construire une roadmap purement technologique",
    error:
      "Présenter une roadmap IA structurée uniquement comme une liste de projets technologiques (« Q1 : ML scoring crédit ; Q2 : chatbot RH ; Q3 : maintenance prédictive… »), sans dimensions humaines (compétences, formation, conduite du changement) ni organisationnelles (gouvernance, processus, dialogue social).",
    mechanism:
      "Une roadmap technologique est rapide à produire — il suffit de lister des projets — mais elle ignore les facteurs limitants réels. Les compétences, l'adoption par les utilisateurs, les processus de gouvernance, la conduite du changement déterminent la réussite plus que la technologie elle-même. Une roadmap qui les ignore produit typiquement des projets bloqués ou mal adoptés.",
    mitigation:
      "Structurer toute roadmap IA en 5 dimensions interdépendantes : vision, use cases prioritaires, gouvernance, compétences et organisation, KPIs. Chaque dimension est nécessaire — l'absence d'une seule fragilise l'ensemble. La dimension compétences/organisation est souvent la plus négligée et pourtant la plus déterminante.",
  },
  {
    title: "Confondre veille technologique et anticipation stratégique",
    error:
      "Souscrire à plusieurs newsletters IA, abonner les équipes à des publications spécialisées, organiser des présentations internes mensuelles — et croire ainsi anticiper. Constater au bout de 12-24 mois que les décisions stratégiques importantes ont été prises hors de tout dispositif structuré, sur la base d'intuitions individuelles.",
    mechanism:
      "La veille (collecte d'information sur ce qui existe et émerge) est passive. Elle alimente potentiellement l'anticipation stratégique mais ne la remplace pas. L'anticipation stratégique demande un travail actif d'analyse des implications pour l'organisation, d'identification des décisions à prendre, de construction d'options stratégiques. Sans ce travail actif, la veille produit des présentations intéressantes mais peu d'effet sur les décisions.",
    mitigation:
      "Articuler explicitement veille et anticipation. La veille est un input ; l'anticipation est un processus. L'anticipation stratégique se traduit par des livrables : analyse trimestrielle d'implications, mise à jour des scénarios, identification de décisions à prendre, options stratégiques formalisées. Désigner un responsable explicite pour ce processus, avec mandat de proposition au comité IA.",
  },
  {
    title: "Sous-estimer le délai entre annonce et adoption en entreprise",
    error:
      "Réagir immédiatement à chaque annonce technologique majeure (« GPT-X est sorti », « tel modèle a battu tel benchmark », « tel acteur a annoncé telle capacité »). Engager des projets internes en supposant que la maturité opérationnelle sera atteinte aux délais annoncés — et constater régulièrement que les projets dérapent.",
    mechanism:
      "Le délai entre l'annonce d'une capacité technique et son adoption industrielle robuste en entreprise est typiquement de 12 à 36 mois — voire plus pour les usages sensibles (réglementés, à fort enjeu). Les annonces médiatisées présentent les capacités au mieux ; la réalité opérationnelle (intégration, fiabilité, conformité, conduite du changement) est plus lente. Sous-estimer ce délai produit des roadmaps irréalistes.",
    mitigation:
      "Distinguer trois temps : (1) annonce technologique (médiatique, marketing, parfois prématurée), (2) maturité technique opérationnelle (le marché des fournisseurs s'est structuré, les bonnes pratiques émergent), (3) maturité organisationnelle interne (votre organisation a les compétences, données, processus). Calibrer les engagements sur le temps 3, pas le temps 1. Compter typiquement 12-24 mois de décalage entre une annonce structurante et sa contribution réelle au business.",
  },
];

// === ACTIVITY STEPS ===
const activitySteps = [
  {
    heading: "Vision IA et cartographie de maturité",
    body: "Formulez la vision IA de votre organisation à 3-5 ans en 3-5 lignes — spécifique à votre organisation, articulant ce à quoi vous voulez ressembler, la valeur créée pour vos parties prenantes, et l'inscription dans votre stratégie. Cartographiez ensuite la maturité actuelle sur 8 dimensions (données, compétences, gouvernance, projets en production, conformité, conduite du changement, infrastructure, dialogue social). La maturité encadre les ambitions.",
  },
  {
    heading: "Construire 3 scénarios contrastés",
    body: "Construisez 3 scénarios IA à 3-5 ans : continuité accélérée, rupture technologique, resserrement réglementaire et social. Pour chaque scénario, identifiez les implications principales pour votre organisation. Identifiez les actions robustes — celles qui sont utiles dans au moins 2 scénarios sur 3. Ces actions robustes sont à privilégier en investissement.",
  },
  {
    heading: "Décliner en use cases prioritaires",
    body: "Listez 5 à 10 use cases IA candidats. Pour chacun, scorez sur valeur business, faisabilité (qualité données + intégration + maturité organisation), risque (éthique, réglementaire, technique). Calculez un score net (V × F − R). Sélectionnez le top 3 et positionnez chacun sur un horizon temporel (court / moyen / long terme).",
  },
  {
    heading: "Plan d'action 12-24 mois",
    body: "Structurez la roadmap par horizon : 0-6 mois (fondations : gouvernance, premier pilote peu risqué, KPIs) / 6-12 mois (premiers projets à valeur business mesurable, montée en compétences) / 12-24 mois (projets ambitieux qui dépendent de la maturité acquise). Pour chaque dimension de la roadmap (vision, use cases, gouvernance, compétences, KPIs), précisez les actions par horizon. Chiffrez le budget global, identifiez les risques majeurs et leurs plans de mitigation.",
  },
];

const activityCriteria = [
  "La vision IA est spécifique à votre organisation (non interchangeable).",
  "La cartographie de maturité couvre les 8 dimensions clés.",
  "3 scénarios contrastés sont construits avec implications identifiées.",
  "Le top 3 des use cases est priorisé sur valeur, faisabilité et risque.",
  "Le plan 24 mois est structuré en 5 dimensions avec budget et risques.",
];

// === CHECKLIST GROUPS ===
const checklistGroups = [
  {
    title: "Vision et anticipation",
    items: [
      "La vision IA à 3-5 ans est formulée explicitement et spécifiquement à l'organisation.",
      "Au moins 3 scénarios IA contrastés à 3-5 ans ont été construits.",
      "Les actions robustes (utiles dans plusieurs scénarios) sont identifiées et priorisées.",
      "Un dispositif d'anticipation stratégique active existe (pas seulement de la veille).",
    ],
  },
  {
    title: "Roadmap structurée",
    items: [
      "La roadmap couvre les 5 dimensions (vision, use cases, gouvernance, compétences, KPIs).",
      "La séquence temporelle (0-6 / 6-12 / 12-24 mois) respecte les dépendances naturelles (fondations avant ambition).",
      "Chaque use case prioritaire est rattaché à une dimension stratégique de Porter (différenciation / coût / focalisation).",
      "Les compétences à recruter, à former, à redéployer sont identifiées explicitement.",
    ],
  },
  {
    title: "Budget, risques et exécution",
    items: [
      "Le budget global 24 mois est chiffré avec sources de financement.",
      "Les risques majeurs (techniques, réglementaires, sociaux, financiers) sont identifiés avec plans de mitigation.",
      "Les KPIs principaux (3-5 indicateurs) sont définis et mesurables.",
      "La synthèse roadmap une page est défendable en 5 minutes au COMEX et au Conseil.",
    ],
  },
];

// === TAKEAWAYS ===
const takeaways = [
  "Le concept clé : le scenario planning permet de prendre des décisions stratégiques face à l'incertitude IA — penser plusieurs futurs plutôt qu'en prédire un seul, identifier les actions robustes à plusieurs scénarios.",
  "Le cas exemplaire : le MIT Initiative on the Digital Economy montre comment une institution académique structure une recherche prospective sur l'avenir du travail et de l'économie numérique — méthode transposable à l'échelle d'une organisation.",
  "Le piège majeur : construire une roadmap purement technologique sans dimension humaine et organisationnelle — les compétences, l'adoption, la conduite du changement déterminent la réussite plus que la technologie.",
  "L'outil opérationnel : le canvas roadmap IA en 4 étapes (vision et maturité / 3 scénarios / use cases prioritaires / plan 12-24 mois 5 dimensions) — qui sert également de préparation au capstone.",
  "La conclusion du parcours : les 6 modules vous ont donné un cadre complet (introduction, ML, GenAI, robotique, gouvernance/société, futur et roadmap). Le capstone consiste à appliquer ce cadre à votre organisation pour produire une roadmap IA défendable.",
];

// === RESOURCES ===
const resources = [
  {
    type: 'reading' as const,
    title: 'MIT Initiative on the Digital Economy',
    author: 'MIT Sloan',
    description:
      "Initiative de recherche du MIT Sloan sur l'avenir du travail, de l'économie numérique, et de l'impact des technologies. Publications régulières et accessibles sur les évolutions structurantes — base solide pour l'anticipation stratégique.",
    href: 'https://ide.mit.edu/',
    sourceLevel: 'recommended-complement' as const,
  },
  {
    type: 'reading' as const,
    title: 'Future of Jobs Report',
    author: 'World Economic Forum (WEF)',
    description:
      "Rapport biennal du World Economic Forum sur l'évolution attendue des emplois et compétences. Données enquêtes auprès de centaines d'entreprises à l'échelle mondiale. Référence pour le cadrage compétences d'une roadmap IA.",
    href: 'https://www.weforum.org/publications/series/future-of-jobs/',
    sourceLevel: 'external-verifiable' as const,
  },
  {
    type: 'reading' as const,
    title: 'Generative AI and Collective Intelligence',
    author: 'MIT Center for Collective Intelligence',
    description:
      "Ressource MIT articulant explicitement IA générative et intelligence collective — perspective utile pour les organisations cherchant à orchestrer humains et machines plutôt que substituer.",
    href: 'https://cci.mit.edu/generative-ai-and-collective-intelligence/',
    sourceLevel: 'recommended-complement' as const,
  },
  {
    type: 'reading' as const,
    title: 'AI Risk Management Framework (AI RMF 1.0)',
    author: 'NIST — National Institute of Standards and Technology',
    description:
      "Cadre opérationnel américain de référence pour la gouvernance et la gestion des risques IA. Reste pertinent pour la prospective : structure les principes durables d'une gouvernance IA face aux évolutions futures.",
    href: 'https://www.nist.gov/itl/ai-risk-management-framework',
    sourceLevel: 'external-verifiable' as const,
  },
  {
    type: 'reading' as const,
    title: 'Règlement (UE) 2024/1689 — AI Act et calendrier d\'application',
    author: "Journal officiel de l'Union européenne",
    description:
      "Texte intégral et calendrier d'application progressif jusqu'en 2027. Indispensable pour anticiper les obligations applicables à votre organisation dans les 24-36 prochains mois.",
    href: 'https://eur-lex.europa.eu/legal-content/FR/TXT/PDF/?uri=OJ%3AL_202401689',
    sourceLevel: 'external-verifiable' as const,
  },
  {
