---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSecondary from '@/components/HeroSecondary.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ExecutiveSummary from '@/components/ExecutiveSummary.astro';
import OutcomesList from '@/components/OutcomesList.astro';
import ConceptCard from '@/components/ConceptCard.astro';
import SourceTag from '@/components/SourceTag.astro';
import PitfallList from '@/components/PitfallList.astro';
import CaseCardCompact from '@/components/CaseCardCompact.astro';
import Activity from '@/components/Activity.astro';
import QuizInteractive from '@/components/QuizInteractive';
import Checklist from '@/components/Checklist.astro';
import KeyTakeaways from '@/components/KeyTakeaways.astro';
import ResourceList from '@/components/ResourceList.astro';
import PrevNextNav from '@/components/PrevNextNav.astro';
import PrintButton from '@/components/PrintButton.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import { getLocalizedUrl } from '@/i18n/helpers';
import quizModule4 from '@/content/quizzes/module-4';

const locale = 'fr';

// === TABLE OF CONTENTS ===
const tocItems = [
  { id: 'synthese-executive', label: 'Synthèse exécutive' },
  { id: 'objectifs', label: "Objectifs d'apprentissage" },
  { id: 'concepts', label: 'Concepts clés' },
  { id: 'erreurs-frequentes', label: 'Erreurs fréquentes' },
  { id: 'cas-reel', label: 'Cas réel' },
  { id: 'activite', label: 'Activité pratique' },
  { id: 'quiz', label: 'Quiz formatif' },
  { id: 'checklist', label: 'Checklist manager' },
  { id: 'application', label: 'Application dans votre organisation' },
  { id: 'a-retenir', label: 'À retenir' },
  { id: 'pour-aller-plus-loin', label: 'Pour aller plus loin' },
];

// === LEARNING OUTCOMES ===
const outcomes = [
  "Distinguer robot industriel classique, cobot et robot mobile autonome (AMR/AGV) — et savoir lequel correspond à un cas d'usage.",
  "Comprendre les trois piliers d'un système robotique (perception, planification, contrôle) et leurs implications pour le cadrage de projet.",
  "Connaître les normes de sécurité applicables (ISO 10218 pour les robots industriels, ISO/TS 15066 pour les cobots) et les obligations qui en découlent.",
  "Évaluer le coût total réel d'un projet robotique en intégrant la part décisive de l'intégration (50-70 % du total).",
  "Construire un cadrage économique et social défendable : payback, dimension RH, dialogue social, conduite du changement.",
];

// === PITFALLS ===
const pitfalls = [
  {
    title: "Comparer des prix de robots sans comparer le coût total",
    error:
      "Choisir un robot ou un cobot en se fondant principalement sur son prix d'achat (« 25 000 € pour celui-ci, 35 000 € pour celui-là »), et découvrir en cours d'intégration que les coûts réels (préhenseurs, programmation, certification, formation, modifications de l'environnement) bouleversent complètement le classement initial.",
    mechanism:
      "Le prix d'achat du robot est une métrique facile à comparer entre fournisseurs. Le coût d'intégration est diffus, propre au site, et difficile à anticiper sans expérience. L'intégration représente typiquement 50 à 70 % du coût total du projet — le robot lui-même n'est que 30 à 50 %. Sous-estimer cette répartition mène à des dossiers économiquement faux.",
    mitigation:
      "Toujours raisonner en coût total du projet, jamais en prix de robot. Découper le budget en au moins 8 lignes (robot + outillage + étude de poste + programmation + mise au point + sécurité + formation + maintenance première année). Si le robot représente plus de 50 % du total, l'intégration est probablement sous-estimée.",
  },
  {
    title: "Confondre robotique standalone et robotique collaborative",
    error:
      "Choisir un robot industriel classique en supposant qu'on pourra le « rendre collaboratif » avec des dispositifs ajoutés (capteurs externes, barrières immatérielles), ou inversement choisir un cobot en pensant qu'il atteindra les performances d'un robot industriel — et constater que les deux paris sont perdus.",
    mechanism:
      "Robot industriel et cobot répondent à des cadres normatifs et techniques différents. Le robot industriel (ISO 10218) est conçu pour la performance brute en isolation des humains ; le cobot (ISO/TS 15066) est conçu pour la coexistence avec contrôle de force et de vitesse. Tenter de combler l'écart par des ajouts ne change pas la nature du système et peut compromettre la sécurité.",
    mitigation:
      "Décider tôt et clairement entre les deux familles. Si le poste exige une coexistence humaine fréquente, le cobot est la bonne réponse — accepter ses limites de performance. Si la performance brute prime et que le poste peut être isolé, le robot industriel est la bonne réponse — accepter la cellule grillagée. Les solutions hybrides existent mais demandent une expertise spécifique en intégration de sécurité.",
  },
  {
    title: "Sous-estimer les enjeux RH, sociaux et juridiques",
    error:
      "Présenter un projet robotique en COMEX uniquement sur les chiffres de productivité et de payback, sans traiter explicitement les conséquences pour les opérateurs concernés (redéploiement, formation, suppression de postes), et découvrir tardivement les blocages — refus du CSE, contestation syndicale, conflit prud'homal, atteinte à la marque employeur.",
    mechanism:
      "La robotique change le cadre de travail. La législation française et européenne impose des obligations spécifiques : information-consultation du CSE, étude d'impact, plan de formation, accompagnement des salariés concernés. Ignorer ces obligations expose juridiquement l'employeur, et abaisse les chances de réussite opérationnelle (un projet contesté est mal adopté par les équipes).",
    mitigation:
      "Intégrer dès le cadrage initial une dimension RH explicite : qui est concerné, quel parcours est proposé (redéploiement, formation, mobilité), comment le dialogue social est conduit. Privilégier les projets dont le bénéfice combine productivité + ergonomie + qualité, plus défendables socialement que les projets de pure réduction de masse salariale.",
  },
  {
    title: "Négliger la maintenance et le run après mise en service",
    error:
      "Considérer le projet robotique comme « fini » à la mise en service, sans budget récurrent pour la maintenance, sans contrat de service avec l'intégrateur, sans personnel formé en interne pour les interventions de premier niveau — et constater que les arrêts non programmés détruisent le ROI initialement calculé.",
    mechanism:
      "Un robot en production est exposé à l'usure mécanique, à la dégradation des capteurs, à la dérive des programmes au fil des évolutions de produits, à des incidents (collision, surcharge). Sans dispositif de maintenance préventive et corrective, le taux de disponibilité chute. Or le calcul de payback suppose une disponibilité élevée et durable.",
    mitigation:
      "Budgétiser explicitement la maintenance préventive (typiquement 5-10 % de l'investissement par an), le contrat de service avec l'intégrateur, et la formation interne d'un référent maintenance. Mesurer en continu le taux de disponibilité (TRS) et le comparer à l'hypothèse du calcul de payback. Adapter dès qu'un écart se confirme.",
  },
];

// === ACTIVITY STEPS ===
const activitySteps = [
  {
    heading: "Décrire le poste candidat",
    body: "Choisissez un poste candidat à la robotisation dans votre organisation. Décrivez précisément le travail actuel : qui le fait, avec quels outils, à quelle cadence. Identifiez les caractéristiques (répétitif, pénible, précis, risqué). Formulez en une phrase pourquoi ce poste est candidat — privilégier les motivations combinées (ergonomie + productivité) aux pures réductions de coûts salariaux.",
  },
  {
    heading: "Choisir la famille robotique",
    body: "Décidez entre robot industriel classique (ISO 10218, performance brute, isolation), cobot (ISO/TS 15066, coexistence humaine), ou robot mobile autonome (AMR/AGV pour transport en environnements changeants). Justifiez le choix en 2 lignes — il doit être traçable jusqu'à l'argumentaire COMEX.",
  },
  {
    heading: "Analyser sécurité et intégration",
    body: "Identifiez le cadre normatif applicable, listez les exigences de sécurité (analyse de risque, mesure de force/vitesse pour cobots, formation, procédures incident, maintenance). Inventoriez les composants d'intégration nécessaires (préhenseurs, convoyeurs, capteurs, interfaces SI, modifications environnement). Estimez la durée d'intégration en semaines.",
  },
  {
    heading: "Évaluer coût total et payback",
    body: "Découpez le coût en au moins 8 lignes (robot + outillage + étude + programmation + mise au point + sécurité + formation + maintenance). Estimez les gains multi-dimensionnels (productivité + qualité + ergonomie + flexibilité). Calculez le payback. Cible : 18-36 mois pour un projet bien cadré, 36-60 mois acceptable si l'ergonomie ou la qualité justifient.",
  },
];

const activityCriteria = [
  "Le poste candidat est décrit précisément (qui, quoi, combien).",
  "La famille robotique est choisie et justifiée (industriel/cobot/AMR).",
  "Le cadre normatif applicable est identifié et au moins 4 exigences de sécurité prévues.",
  "Le coût total est découpé en au moins 8 lignes ; le robot représente moins de 50 % du total.",
  "Les gains sont multi-dimensionnels et la dimension RH est traitée explicitement.",
];

// === CHECKLIST GROUPS ===
const checklistGroups = [
  {
    title: "Cadrage technique du projet",
    items: [
      "Le poste candidat est décrit avec précision (volume, cadence, environnement, contraintes).",
      "Le choix de famille robotique (industriel, cobot, AMR) est justifié au regard du poste.",
      "Les trois piliers (perception, planification, contrôle) sont correctement positionnés pour le cas.",
      "L'intégrateur retenu a des références vérifiables sur des projets similaires.",
    ],
  },
  {
    title: "Sécurité, normes et conformité",
    items: [
      "Le cadre normatif applicable est identifié (ISO 10218 / ISO/TS 15066 / Directive Machines).",
      "Une analyse de risque formelle est prévue avant la mise en service (par l'intégrateur, contre-expertise interne).",
      "La formation et la certification des opérateurs sont planifiées (procédures d'urgence, signalement d'incident).",
      "Un plan de maintenance préventive et de contrôle de sécurité périodique est défini.",
    ],
  },
  {
    title: "Économie et social",
    items: [
      "Le coût total intègre l'intégration (50-70 % typiques) en plus du robot lui-même.",
      "Les gains attendus sont multi-dimensionnels (productivité + qualité + ergonomie + flexibilité).",
      "Le payback estimé est dans une fourchette défendable (18-36 mois cible, 36-60 mois si ergonomie/qualité forts).",
      "La dimension RH est traitée : information-consultation CSE, plan de formation, accompagnement des salariés concernés.",
    ],
  },
];

// === TAKEAWAYS ===
const takeaways = [
  "Le concept clé : la robotique en entreprise repose sur trois piliers (perception, planification, contrôle) — le choix de famille (robot industriel, cobot, AMR) est structurant pour la suite.",
  "Le cas exemplaire : Amazon Robotics montre comment l'intégration massive de robotique mobile autonome dans la logistique transforme l'économie de la chaîne de distribution — orchestration humain + machine, pas remplacement.",
  "Le piège majeur : comparer des prix de robots sans comparer les coûts totaux — l'intégration représente 50-70 % du coût d'un projet robotique en entreprise.",
  "L'outil opérationnel : le canvas d'évaluation projet robotique en 4 étapes (poste / famille / sécurité+intégration / coût total et payback) avant tout engagement.",
  "La suite : le Module 5 prend du recul et explore les enjeux d'IA dans l'entreprise et la société (gouvernance, éthique, travail, conformité) — qui dépassent une famille technologique particulière.",
];

// === RESOURCES ===
const resources = [
  {
    type: 'video' as const,
    title: 'Introduction to Robotics (cours complet)',
    author: 'MIT OpenCourseWare — 2.12',
    description:
      "Cours d'introduction MIT à la robotique. Bases techniques (cinématique, dynamique, contrôle, perception) accessibles à un public motivé. Vidéos, polycopiés, exercices.",
    href: 'https://ocw.mit.edu/courses/2-12-introduction-to-robotics-fall-2005/',
    sourceLevel: 'recommended-complement' as const,
  },
  {
    type: 'reading' as const,
    title: 'Amazon deploys over 1 million robots and launches new AI foundation model',
    author: 'About Amazon (communications officielles)',
    description:
      "Communication officielle Amazon sur le déploiement de plus d'un million de robots dans son réseau logistique et le lancement de DeepFleet. Cas exemplaire d'orchestration humain-machine à très grande échelle.",
    href: 'https://www.aboutamazon.com/news/operations/amazon-million-robots-ai-foundation-model',
    sourceLevel: 'external-verifiable' as const,
  },
  {
    type: 'reading' as const,
    title: 'AI Risk Management Framework (AI RMF 1.0)',
    author: 'NIST — National Institute of Standards and Technology',
    description:
      "Cadre opérationnel américain pour la gestion des risques IA, applicable aussi aux systèmes robotiques autonomes ou intégrant de l'IA. Référence pour les responsables gouvernance et sécurité.",
    href: 'https://www.nist.gov/itl/ai-risk-management-framework',
    sourceLevel: 'external-verifiable' as const,
  },
  {
    type: 'reading' as const,
    title: 'Règlement (UE) 2024/1689 — AI Act',
    author: "Journal officiel de l'Union européenne",
    description:
