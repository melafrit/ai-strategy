---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSecondary from '@/components/HeroSecondary.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ExecutiveSummary from '@/components/ExecutiveSummary.astro';
import OutcomesList from '@/components/OutcomesList.astro';
import ConceptCard from '@/components/ConceptCard.astro';
import SourceTag from '@/components/SourceTag.astro';
import PitfallList from '@/components/PitfallList.astro';
import CaseCardCompact from '@/components/CaseCardCompact.astro';
import Activity from '@/components/Activity.astro';
import QuizInteractive from '@/components/QuizInteractive';
import Checklist from '@/components/Checklist.astro';
import KeyTakeaways from '@/components/KeyTakeaways.astro';
import ResourceList from '@/components/ResourceList.astro';
import PrevNextNav from '@/components/PrevNextNav.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import { getLocalizedUrl } from '@/i18n/helpers';
import quizModule1 from '@/content/quizzes/module-1';

const locale = 'fr';

// === TABLE OF CONTENTS ===
const tocItems = [
  { id: 'synthese-executive', label: 'Synthèse exécutive' },
  { id: 'objectifs', label: "Objectifs d'apprentissage" },
  { id: 'concepts', label: 'Concepts clés' },
  { id: 'erreurs-frequentes', label: 'Erreurs fréquentes' },
  { id: 'cas-reel', label: 'Cas réel' },
  { id: 'activite', label: 'Activité pratique' },
  { id: 'quiz', label: 'Quiz formatif' },
  { id: 'checklist', label: 'Checklist manager' },
  { id: 'application', label: 'Application dans votre organisation' },
  { id: 'a-retenir', label: 'À retenir' },
  { id: 'pour-aller-plus-loin', label: 'Pour aller plus loin' },
];

// === LEARNING OUTCOMES ===
const outcomes = [
  "Distinguer l'IA étroite (narrow AI) de l'IA générale (AGI), et situer où en est l'état de l'art aujourd'hui.",
  "Retracer les trois grandes vagues de l'histoire de l'IA et expliquer ce qui a déclenché la vague actuelle.",
  "Définir l'intelligence collective et expliquer comment personnes et machines se combinent pour produire des organisations plus intelligentes.",
  "Identifier les composantes d'un système socio-technique et raisonner sur l'IA comme un système, pas comme un outil isolé.",
  "Utiliser un cadre de cadrage stratégique simple pour analyser un usage potentiel de l'IA dans son organisation.",
];

// === PITFALLS ===
const pitfalls = [
  {
    title: "Confondre la performance d'un modèle et la valeur business d'un projet",
    error:
      "Un modèle qui atteint 95 % de précision en laboratoire est jugé prêt à déployer, alors qu'il n'a jamais été testé sur des données métier réelles, ni dans le workflow opérationnel existant.",
    mechanism:
      "Les démonstrations techniques produisent des chiffres impressionnants en environnement contrôlé, mais la valeur business dépend de l'intégration au processus, de l'adoption par les utilisateurs, et de la qualité des données réelles — qui sont presque toujours différentes des données d'entraînement.",
    mitigation:
      "Avant tout pilote, exiger une métrique business (temps gagné, taux d'erreur réduit, satisfaction client) en plus de la métrique technique. Tester sur un échantillon de données opérationnelles authentiques. Mesurer l'effet sur l'utilisateur final, pas seulement sur le modèle.",
  },
  {
    title: "Penser l'IA comme un produit prêt à l'emploi plutôt qu'un système à construire",
    error:
      "Achat d'une solution IA externe en supposant qu'elle fonctionnera 'out of the box' dans le contexte de l'organisation, sans investissement dans les données, le workflow, ou la formation des équipes.",
    mechanism:
      "Les vendeurs présentent leurs solutions comme universelles. La réalité est que tout déploiement IA est un système qui combine modèle + données spécifiques + interface utilisateur + processus métier + gouvernance. Aucune de ces couches n'est universelle.",
    mitigation:
      "Cadrer chaque projet IA comme un projet de transformation organisationnelle, pas comme un achat logiciel. Prévoir explicitement budget et calendrier pour les couches données, workflow, formation, et gouvernance. Estimer typiquement 20-40 % du budget total sur le modèle lui-même, le reste sur l'écosystème.",
  },
  {
    title: "Sous-estimer le rôle de l'humain dans le système IA",
    error:
      "Conception d'un projet IA visant l'automatisation complète d'une tâche, alors que les utilisateurs métier ont besoin de garder la main sur les décisions sensibles ou exceptionnelles.",
    mechanism:
      "L'idée séduisante de 'remplacer' une tâche humaine occulte deux réalités : la majorité des tâches contiennent des cas limites où l'humain est indispensable, et la confiance des utilisateurs dépend de leur capacité à intervenir, surveiller et corriger.",
    mitigation:
      "Concevoir d'emblée des dispositifs human-in-the-loop : qui valide, qui supervise, qui corrige, et avec quels critères. Mesurer non seulement la performance du modèle, mais aussi l'efficacité de la collaboration humain-machine. Documenter les exceptions où l'humain reprend la main.",
  },
  {
    title: "Cadrer l'IA hors stratégie d'entreprise",
    error:
      "Lancer des pilotes IA dispersés (chatbot RH, prédictions de ventes, détection de fraude) sans lien explicite avec la stratégie globale (différenciation, leadership de coût, ou focalisation).",
    mechanism:
      "Sans cadre stratégique, chaque projet IA se justifie par lui-même mais ne s'additionne pas. L'organisation se retrouve avec un patchwork de POC qui ne créent ni avantage concurrentiel durable, ni capability transverse.",
    mitigation:
      "Pour chaque projet IA candidate, formuler explicitement à quelle dimension stratégique il contribue (différenciation par expérience client, baisse de coût opérationnel, focalisation sur un segment). Si la réponse est ambiguë, le projet est probablement prématuré ou mal cadré.",
  },
];

// === ACTIVITY STEPS ===
const activitySteps = [
  {
    heading: 'Cartographier votre organisation',
    body: 'Listez 5 à 10 processus métier critiques de votre organisation. Pour chacun, notez : qui le réalise (rôle métier), avec quels outils, et quel volume / fréquence. L\'objectif est d\'avoir une vision globale avant de chercher des cas d\'usage IA.',
  },
  {
    heading: 'Identifier les candidats IA',
    body: "Pour chaque processus, posez 3 questions : (1) y a-t-il une décision répétitive qui pourrait être assistée ? (2) y a-t-il une grande quantité de données sous-exploitées ? (3) y a-t-il un goulot d'étranglement dont la résolution créerait beaucoup de valeur ? Marquez chaque processus en 'candidat IA fort', 'moyen', ou 'faible'.",
  },
  {
    heading: "Cadrer stratégiquement",
    body: "Pour les 3 candidats les plus prometteurs, formulez en une phrase à quelle dimension stratégique l'IA contribuerait : différenciation produit, baisse de coût, focalisation sur un segment, ou amélioration interne (compétences, gouvernance). Éliminez ceux dont le lien stratégique est faible.",
  },
  {
    heading: "Évaluer le ratio valeur / risque",
    body: "Pour les candidats restants, évaluez sur une échelle de 1 à 5 : (a) la valeur business attendue si le projet réussit, (b) la difficulté de mise en œuvre (données, intégration, conduite du changement), (c) le risque éthique ou réglementaire. Le candidat à privilégier en pilote est celui qui combine forte valeur et difficulté maîtrisable.",
  },
];

const activityCriteria = [
  "Les processus listés couvrent au moins deux fonctions différentes (ex. ventes et opérations).",
  "Chaque candidat IA est rattaché explicitement à une dimension stratégique.",
  "L'évaluation valeur/risque est explicite et défendable devant un COMEX.",
  "Le candidat retenu pour le pilote est défendu en moins de 90 secondes oralement.",
];

// === QUIZ ===
// Quiz data lives in src/content/quizzes/module-1.ts (canonical, typed,
// reusable by the future Phase 5 React Quiz island without rewrite).
// See src/lib/quiz-schema.ts for the shape contract.

// === CHECKLIST GROUPS ===
const checklistGroups = [
  {
    title: 'Cadrage stratégique',
    items: [
      "L'usage IA envisagé est rattaché explicitement à une dimension stratégique (différenciation / coût / focalisation).",
      "La cartographie des processus métier critiques de mon organisation est à jour.",
      "Au moins 3 candidats IA ont été identifiés et comparés sur valeur et faisabilité.",
      "Le candidat de pilote retenu est défendable devant un COMEX en moins de 2 minutes.",
    ],
  },
  {
    title: 'Évaluation système',
    items: [
      "Le projet est cadré comme un système (modèle + données + workflow + utilisateurs + gouvernance), pas comme un outil isolé.",
      "Le rôle de l'humain dans la boucle est explicite : qui valide, qui supervise, qui corrige.",
      "Les métriques de succès incluent une métrique business, pas seulement une métrique technique.",
      "Les risques éthiques et réglementaires (biais, vie privée, AI Act) sont identifiés et adressés.",
    ],
  },
  {
    title: 'Préparation de la décision',
    items: [
      "Les données nécessaires existent ou sont accessibles à coût raisonnable.",
      "Le budget couvre l'écosystème (données, intégration, formation), pas uniquement le modèle.",
      "Le calendrier inclut une phase de pilote avant déploiement à l'échelle.",
      "Un comité de gouvernance IA est désigné ou prévu, avec rôles et cadence définis.",
    ],
  },
];

// === TAKEAWAYS ===
const takeaways = [
  "Le concept clé : toute IA est aujourd'hui une IA étroite, performante sur une tâche spécifique mais sans transposition automatique à d'autres problèmes — pas d'IA générale en production.",
  "Le cas exemplaire : Takeda × MIT CCI montre que la valeur business vient de l'orchestration humain-machine (intelligence collective), pas du remplacement humain.",
  "Le piège majeur : confondre performance technique du modèle et valeur business du projet — la précision du modèle ne suffit jamais comme métrique de succès.",
  "L'outil opérationnel : le cadrage stratégique en 4 étapes (cartographier / identifier / cadrer / évaluer) avant tout pilote.",
  "La suite : le Module 2 entre dans le détail du machine learning et apprend à juger la pertinence d'un cas d'usage ML spécifique.",
];

// === RESOURCES ===
const resources = [
  {
    type: 'reading' as const,
    title: "What business leaders need to know about artificial intelligence",
    author: 'MIT Sloan Ideas Made to Matter',
    description:
      "Synthèse managériale très accessible : définitions, cadrages business, écueils typiques. Bon point d'entrée non technique.",
    href: 'https://mitsloan.mit.edu/ideas-made-to-matter/what-business-leaders-need-to-know-about-artificial-intelligence',
    sourceLevel: 'recommended-complement' as const,
  },
  {
