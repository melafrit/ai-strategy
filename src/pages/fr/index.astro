---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrustBar from '@/components/TrustBar.astro';
import AudienceCard from '@/components/AudienceCard.astro';
import ModuleCard from '@/components/ModuleCard.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import { getLocalizedUrl } from '@/i18n/helpers';
import { t } from '@/i18n/translations';

const locale = 'fr';
const description =
  "Site pédagogique trilingue inspiré du programme MIT Sloan Artificial Intelligence: Implications for Business Strategy. Stratégie IA, machine learning, IA générative, robotique, gouvernance.";

const audiences = [
  {
    icon: 'briefcase' as const,
    label: t('audiences.executive.label', locale),
    description: t('audiences.executive.description', locale),
    ctaLabel: t('audiences.executive.cta', locale),
    ctaHref: getLocalizedUrl('/capstone/', locale),
  },
  {
    icon: 'wrench' as const,
    label: t('audiences.consultant.label', locale),
    description: t('audiences.consultant.description', locale),
    ctaLabel: t('audiences.consultant.cta', locale),
    ctaHref: getLocalizedUrl('/ressources/', locale),
  },
  {
    icon: 'graduation-cap' as const,
    label: t('audiences.educator.label', locale),
    description: t('audiences.educator.description', locale),
    ctaLabel: t('audiences.educator.cta', locale),
    ctaHref: getLocalizedUrl('/modules/', locale),
  },
];

const modules = [
  { number: 1 as const, titleKey: 'modules.module-1.title', summaryKey: 'modules.module-1.summary', slug: '01-introduction-ia', available: true },
  { number: 2 as const, titleKey: 'modules.module-2.title', summaryKey: 'modules.module-2.summary', slug: '02-machine-learning', available: true },
  { number: 3 as const, titleKey: 'modules.module-3.title', summaryKey: 'modules.module-3.summary', slug: '03-ia-generative', available: true },
  { number: 4 as const, titleKey: 'modules.module-4.title', summaryKey: 'modules.module-4.summary', slug: '04-robotique', available: true },
  { number: 5 as const, titleKey: 'modules.module-5.title', summaryKey: 'modules.module-5.summary', slug: '05-ia-societe', available: true },
  { number: 6 as const, titleKey: 'modules.module-6.title', summaryKey: 'modules.module-6.summary', slug: '06-futur-ia', available: false },
] as const;

const programmeUrl = getLocalizedUrl('/programme/', locale);
const methodeUrl = getLocalizedUrl('/methode/', locale);
---

<BaseLayout title={t('site.tagline', locale)} description={description}>
  <section class="ai-container ai-hero">
    <p class="ai-hero__surtitle">{t('site.surtitle', locale)}</p>
    <h1 class="ai-hero__title">{t('site.tagline', locale)}</h1>
    <p class="ai-hero__lead">
      Comprendre, prioriser et déployer l'intelligence artificielle dans votre organisation.
      Six modules, une approche business-first, des sources hiérarchisées et une indépendance assumée
      vis-à-vis du programme original de MIT Sloan.
    </p>
    <div class="ai-hero__actions">
      <a class="ai-cta ai-cta--primary" href={programmeUrl}>{t('cta.discover-program', locale)} →</a>
      <a class="ai-cta ai-cta--secondary" href={methodeUrl}>{t('cta.read-method', locale)}</a>
    </div>
  </section>

  <TrustBar />

  <section class="ai-container ai-section">
    <h2 class="ai-section__title">{t('audiences.title', locale)}</h2>
    <p class="ai-section__lead">
      Trois publics, trois manières d'utiliser le site. Chaque parcours mène à des contenus
      pratiques et opérationnels.
    </p>
    <div class="ai-audiences-grid">
      {audiences.map((audience) => <AudienceCard {...audience} />)}
    </div>
  </section>

  <section class="ai-section--full">
    <div class="ai-container ai-section">
      <h2 class="ai-section__title">{t('modules.preview.title', locale)}</h2>
      <p class="ai-section__lead">{t('modules.preview.lead', locale)}</p>
      <div class="ai-modules-grid">
        {modules.map((m) => (
          <ModuleCard
            number={m.number}
            title={t(m.titleKey, locale)}
            summary={t(m.summaryKey, locale)}
            href={getLocalizedUrl(`/modules/${m.slug}/`, locale)}
            available={m.available}
          />
        ))}
      </div>
      <p class="ai-section__cta">
        <a href={getLocalizedUrl('/modules/', locale)}>{t('cta.see-modules', locale)} →</a>
      </p>
    </div>
  </section>

  <section class="ai-container ai-section">
    <h2 class="ai-section__title">Comment nous travaillons</h2>
    <div class="ai-method-grid">
      <div class="ai-method-block">
        <h3>Hiérarchie des sources visible</h3>
        <p>
          Chaque affirmation factuelle est étiquetée selon son niveau de preuve : source officielle MIT,
          complément MIT-connexe, reconstruction pédagogique, source externe vérifiable, ou à vérifier.
          Vous savez d'où vient chaque information.
        </p>
      </div>
      <div class="ai-method-block">
        <h3>Indépendance assumée</h3>
        <p>
          Le site est inspiré par les thématiques publiques du programme MIT Sloan, mais il n'est ni affilié,
          ni validé, ni certifié par MIT. C'est une ressource pédagogique indépendante, sourcée et auditable.
        </p>
      </div>
      <div class="ai-method-block">
        <h3>Triple lecture</h3>
        <p>
          Synthèse exécutive pour les dirigeants pressés, contenu pédagogique complet pour qui veut
          approfondir, annexes opérationnelles téléchargeables pour le terrain. Une seule page, trois usages.
        </p>
      </div>
      <div class="ai-method-block">
        <h3>Licence ouverte</h3>
        <p>
          Le code est sous licence MIT, le contenu sous CC BY-NC-SA 4.0. Vous pouvez utiliser, adapter et
          partager, à condition d'attribuer la source, de ne pas faire commerce, et de partager dans les
          mêmes conditions.
        </p>
      </div>
    </div>
    <p class="ai-section__cta">
      <a href={methodeUrl}>{t('cta.read-method', locale)} →</a>
    </p>
  </section>

  <section class="ai-container ai-section ai-section--narrow">
    <IndependenceNotice variant="block" />
  </section>
</BaseLayout>

<style>
  .ai-hero { padding-block: var(--ai-space-7) var(--ai-space-8); }
  .ai-hero__surtitle {
    color: var(--ai-fg-secondary);
    font-size: var(--ai-text-sm);
    font-weight: var(--ai-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--ai-tracking-wide);
    margin: 0 0 var(--ai-space-3);
  }
  :global([dir='rtl']) .ai-hero__surtitle { text-transform: none; letter-spacing: 0; }
  .ai-hero__title {
    max-width: 22ch;
    line-height: var(--ai-leading-tight);
    letter-spacing: var(--ai-tracking-tight);
    margin: 0 0 var(--ai-space-4);
  }
  @media (min-width: 48em) { .ai-hero__title { font-size: var(--ai-text-5xl); } }
  .ai-hero__lead {
    max-width: 60ch;
    color: var(--ai-fg-secondary);
    font-size: var(--ai-text-lg);
    line-height: var(--ai-leading-relaxed);
    margin: 0 0 var(--ai-space-6);
  }
  .ai-hero__actions { display: flex; flex-wrap: wrap; gap: var(--ai-space-3); }

  .ai-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--ai-space-2);
    padding: var(--ai-space-3) var(--ai-space-5);
    border-radius: var(--ai-radius-md);
    font-weight: var(--ai-weight-semibold);
    text-decoration: none;
  }
  .ai-cta--primary { background: var(--ai-accent-primary); color: var(--ai-bg-primary); }
  .ai-cta--primary:hover, .ai-cta--primary:focus-visible { background: var(--ai-accent-hover); }
  .ai-cta--secondary {
    background: transparent;
    color: var(--ai-fg-primary);
    border: 1px solid var(--ai-border-default);
  }
  .ai-cta--secondary:hover, .ai-cta--secondary:focus-visible { background: var(--ai-bg-muted); }

  .ai-section { padding-block: var(--ai-space-7); }
  .ai-section--full { background: var(--ai-bg-subtle); }
  .ai-section--narrow { max-width: var(--ai-container-md); }
  .ai-section__title { margin: 0 0 var(--ai-space-3); }
  .ai-section__lead { margin: 0 0 var(--ai-space-6); color: var(--ai-fg-secondary); font-size: var(--ai-text-lg); max-width: 60ch; }
  .ai-section__cta { margin: var(--ai-space-5) 0 0; font-weight: var(--ai-weight-semibold); }
  .ai-section__cta a { color: var(--ai-accent-primary); text-decoration: none; }
  .ai-section__cta a:hover, .ai-section__cta a:focus-visible { text-decoration: underline; text-underline-offset: 0.2em; }

  .ai-audiences-grid { display: grid; gap: var(--ai-space-4); grid-template-columns: 1fr; }
  @media (min-width: 48em) { .ai-audiences-grid { grid-template-columns: repeat(3, 1fr); } }

  .ai-modules-grid { display: grid; gap: var(--ai-space-4); grid-template-columns: 1fr; }
  @media (min-width: 40em) { .ai-modules-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64em) { .ai-modules-grid { grid-template-columns: repeat(3, 1fr); } }

  .ai-method-grid { display: grid; gap: var(--ai-space-5); grid-template-columns: 1fr; }
  @media (min-width: 48em) { .ai-method-grid { grid-template-columns: repeat(2, 1fr); } }
  .ai-method-block h3 { margin: 0 0 var(--ai-space-2); font-size: var(--ai-text-lg); }
  .ai-method-block p { margin: 0; color: var(--ai-fg-secondary); line-height: var(--ai-leading-relaxed); }
</style>
