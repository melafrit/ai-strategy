    category: 'methodology',
    shortDef: "مشروع ختامي مُدمج لبرنامج. هنا: بناء خارطة طريق ذكاء اصطناعي لمؤسسة، يحشد الوحدات الست. قابل للدفاع في تنفيذي أو في مهمة استشارية.",
    longDef: "مصطلح «capstone» — حجر التتويج لمبنى — يُشير في المسارات التعليمية الأنغلو ساكسونية إلى المشروع الختامي الذي يدمج مجمل مفاهيم المسار في إنتاج متماسك. في تكوين تنفيذي للذكاء الاصطناعي، الـ capstone النموذجي هو بناء خارطة طريق ذكاء اصطناعي لمؤسسة المتعلم، يحشد كامل المسار: تأطير استراتيجي (الوحدة 1)، تقييم حالات استخدام ML (الوحدة 2)، موجز تجربة GenAI (الوحدة 3)، فرص روبوتيات إن أمكن (الوحدة 4)، حوكمة وامتثال (الوحدة 5)، تخطيط طويل المدى (الوحدة 6).\n\ncapstone جيد ليس مُنتَجاً مدرسياً — هو وثيقة قابلة للاستخدام داخلياً، قابلة للدفاع في تنفيذي، تُهيكل فعلاً القرار الاستراتيجي. الصيغة النموذجية تجمع رؤية، تشخيص، حالات استخدام ذات أولوية، تتابع، حوكمة، ميزانية، مهارات، مؤشرات أداء، مخاطر، امتثال، وتخطيط على 12-24 شهراً.",
    example: "لـ PME صناعية، capstone واقعي يمكن أن يكون: خارطة طريق ذكاء اصطناعي تُعطي أولوية لتجربة GenAI على الوثائق التقنية الداخلية (الوحدة 3) وتجربة cobot على أحد المراكز الأكثر إرهاقاً (الوحدة 4)، مع حوكمة مُبسَّطة لكنها حقيقية (الوحدة 5) وتخطيط على 18 شهراً متماسك مع الموارد المتاحة.",
  },
];

const categoryLabelsAR: Record<Term['category'], string> = {
  fundamentals: 'الأساسيات',
  ml: 'تعلّم الآلة',
  genai: 'الذكاء التوليدي',
  robotics: 'الروبوتيات',
  governance: 'الحوكمة والأخلاقيات',
  methodology: 'المنهجية والمشروع',
};

const categoryDescriptionsAR: Record<Term['category'], string> = {
  fundamentals: 'مفاهيم تؤطّر الذكاء الاصطناعي بشكل عام — تعريف، ضيق مقابل عام، أتمتة، ذكاء جماعي.',
  ml: 'تعلّم الآلة — خاضع للإشراف، غير خاضع، بالتعزيز، تعلّم عميق، بيانات تدريب.',
  genai: 'الذكاء التوليدي — LLMs، foundation models، RAG، prompts، هلوسات، fine-tuning.',
  robotics: 'الروبوتيات الصناعية، cobotics، روبوتات متنقلة مستقلة.',
  governance: 'إدارة المخاطر، AI Act الأوروبي، NIST RMF، تحيزات، مساءلة، قابلية للتفسير، human-in-the-loop.',
  methodology: 'مصطلحات مشروع ذكاء اصطناعي — تجربة، خارطة طريق، capstone.',
};

const orderedCategories: Term['category'][] = [
  'fundamentals', 'ml', 'genai', 'robotics', 'governance', 'methodology',
];

const totalTerms = terms.length;
---

<BaseLayout
  title={`القاموس — ${totalTerms} مصطلحاً أساسياً`}
  description={`قاموس ${totalTerms} مصطلحاً أساسياً للذكاء الاصطناعي في الأعمال، منظماً في 6 فئات: الأساسيات، تعلّم الآلة، الذكاء التوليدي، الروبوتيات، الحوكمة، المنهجية. تعريفات كاملة بالعربية مع أمثلة أعمال.`}
>
  <HeroSecondary
    surtitle="القاموس"
    title={`${totalTerms} مصطلحاً أساسياً للذكاء الاصطناعي`}
    lead={`تعريفات كاملة لـ ${totalTerms} مصطلحاً منظمة في 6 فئات. كل مدخل يحتوي على ملخص بجملة واحدة، تعريف كامل من 2-3 فقرات، ومثال أعمال ملموس. انقر على أي مصطلح لتوسيعه.`}
  >
    <span slot="stats">{totalTerms} مصطلح · 6 فئات · تعريفات قصيرة + كاملة · أمثلة أعمال</span>
  </HeroSecondary>

  <div class="ai-container ai-glossary-page">
    <article class="ai-prose">
      <section class="ai-glossary-intro">
        <p>
          يجمع هذا القاموس المصطلحات الـ {totalTerms} اللازمة للتنقل في البرنامج بسهولة. كل مدخل
          يقدم <strong>ملخصاً بجملة واحدة</strong> ويتفتح عند الطلب ليكشف عن
          <strong>تعريف من 2-3 فقرات</strong> مع <strong>مثال أعمال ملموس</strong>.
          <a href={frGlossaireUrl}>النسخة الفرنسية</a> تحتوي إضافياً على إشارات متبادلة بين
          المصطلحات وروابط إلى الوحدات ودراسات الحالة.
        </p>
      </section>

      {orderedCategories.map((cat) => {
        const list = terms.filter((t) => t.category === cat);
        return (
          <section class="ai-glossary-section" id={`category-${cat}`}>
            <header class="ai-glossary-section__head">
              <h2>{categoryLabelsAR[cat]}</h2>
              <p>{categoryDescriptionsAR[cat]} <span class="ai-glossary-section__count">({list.length} مصطلح)</span></p>
            </header>
            <div class="ai-glossary-list">
              {list.map((t) => (
                <details class="ai-glossary-item" id={t.slug}>
                  <summary class="ai-glossary-item__summary">
                    <span class="ai-glossary-item__term">
                      <strong>{t.termAR}</strong>
                      {t.termAR !== t.termFR && (
                        <span class="ai-glossary-item__fr"> — <em>{t.termFR}</em></span>
                      )}
                    </span>
                    <span class="ai-glossary-item__short">{t.shortDef}</span>
                  </summary>
                  <div class="ai-glossary-item__details">
                    <div class="ai-glossary-item__long">
                      {t.longDef.split('\n\n').map((para) => (
                        <p>{para}</p>
                      ))}
                    </div>
                    {t.example && (
                      <aside class="ai-glossary-item__example">
                        <strong>مثال أعمال.</strong> {t.example}
                      </aside>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </section>
        );
      })}

      <IndependenceNotice variant="block" />
    </article>
  </div>
</BaseLayout>

<style>
  .ai-glossary-page { padding-block: var(--ai-space-7) var(--ai-space-8); }
  .ai-glossary-intro {
    background: var(--ai-bg-subtle);
    padding: var(--ai-space-4);
    border-radius: var(--ai-radius-md);
    border-inline-start: 4px solid var(--ai-accent-primary);
    margin-block-end: var(--ai-space-7);
  }
  .ai-glossary-intro p {
    margin: 0;
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
  }
  .ai-glossary-intro a {
    color: var(--ai-accent-primary);
    font-weight: var(--ai-weight-semibold);
    text-decoration: none;
  }
  .ai-glossary-intro a:hover { text-decoration: underline; }

  .ai-glossary-section { margin-block: var(--ai-space-7); scroll-margin-block-start: var(--ai-space-7); }
  .ai-glossary-section__head {
    margin-block-end: var(--ai-space-4);
    padding-block-end: var(--ai-space-2);
    border-block-end: 2px solid var(--ai-accent-primary);
  }
  .ai-glossary-section__head h2 {
    margin: 0 0 var(--ai-space-2);
    font-size: var(--ai-text-xl);
    color: var(--ai-fg-primary);
  }
  .ai-glossary-section__head p {
    margin: 0;
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
    font-size: var(--ai-text-sm);
  }
  .ai-glossary-section__count {
    color: var(--ai-fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .ai-glossary-list {
    display: grid;
    gap: var(--ai-space-3);
    margin: 0;
  }
  .ai-glossary-item {
    background: var(--ai-bg-base);
    border: 1px solid var(--ai-border-subtle);
    border-radius: var(--ai-radius-sm);
    scroll-margin-block-start: var(--ai-space-7);
  }
  .ai-glossary-item[open] {
    border-inline-start: 3px solid var(--ai-accent-primary);
  }
  .ai-glossary-item__summary {
    padding: var(--ai-space-3);
    cursor: pointer;
    list-style: none;
    display: grid;
    gap: var(--ai-space-1);
  }
  .ai-glossary-item__summary::-webkit-details-marker { display: none; }
  .ai-glossary-item__summary::marker { content: ''; }
  .ai-glossary-item__summary::before {
    content: '+';
    float: inline-end;
    font-size: var(--ai-text-lg);
    font-weight: var(--ai-weight-bold);
    color: var(--ai-accent-primary);
    margin-inline-start: var(--ai-space-2);
    line-height: 1;
  }
  .ai-glossary-item[open] .ai-glossary-item__summary::before {
    content: '−';
  }
  .ai-glossary-item__term {
    color: var(--ai-fg-primary);
  }
  .ai-glossary-item__fr {
    color: var(--ai-fg-muted);
    font-size: var(--ai-text-sm);
    font-weight: var(--ai-weight-normal);
  }
  .ai-glossary-item__short {
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
    font-size: var(--ai-text-sm);
  }
  .ai-glossary-item__details {
    padding: 0 var(--ai-space-3) var(--ai-space-3);
    border-block-start: 1px solid var(--ai-border-subtle);
    margin-block-start: var(--ai-space-2);
    padding-block-start: var(--ai-space-3);
  }
  .ai-glossary-item__long p {
    margin: 0 0 var(--ai-space-3);
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
  }
  .ai-glossary-item__long p:last-child {
    margin-block-end: 0;
  }
  .ai-glossary-item__example {
    margin-block-start: var(--ai-space-3);
    padding: var(--ai-space-3);
    background: var(--ai-accent-subtle);
    border-inline-start: 3px solid var(--ai-accent-primary);
    border-radius: var(--ai-radius-sm);
    color: var(--ai-fg-primary);
    line-height: var(--ai-leading-relaxed);
    font-size: var(--ai-text-sm);
  }
  .ai-glossary-item__example strong {
    color: var(--ai-fg-primary);
  }
</style>
