---
/**
 * Root redirect — / → /<best-locale>/
 *
 * Astro handles this at build time by emitting a static HTML file with a
 * <meta http-equiv="refresh"> pointing to the default locale. At runtime,
 * the inline JS below upgrades that to a client-side redirect that respects
 * the visitor's browser language when possible.
 *
 * Why both?
 *  - Server-rendered <meta refresh> guarantees a redirect even with JS off.
 *  - JS replaces the destination with a smarter pick when JS is available.
 */

import { LOCALES, DEFAULT_LOCALE } from '@/i18n/locales';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>AI Strategy</title>
    <meta http-equiv="refresh" content={`0; url=/${DEFAULT_LOCALE}/`} />
    <link rel="canonical" href={`/${DEFAULT_LOCALE}/`} />
    <script is:inline define:vars={{ supportedLocales: LOCALES, defaultLocale: DEFAULT_LOCALE }}>
      (function () {
        try {
          const requested = (navigator.languages || [navigator.language || ''])
            .map(function (l) {
              return (l || '').toLowerCase().split('-')[0];
            })
            .find(function (l) {
              return supportedLocales.indexOf(l) !== -1;
            });
          const target = requested || defaultLocale;
          if (window.location.pathname === '/') {
            window.location.replace('/' + target + '/');
          }
        } catch (_) {
          window.location.replace('/' + defaultLocale + '/');
        }
      })();
    </script>
  </head>
  <body>
    <p>
      Redirection en cours · Redirecting · جاري التحويل
      <a href={`/${DEFAULT_LOCALE}/`}>{DEFAULT_LOCALE}</a>
    </p>
  </body>
</html>
