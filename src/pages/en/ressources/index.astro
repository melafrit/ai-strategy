---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSecondary from '@/components/HeroSecondary.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import { resources, TOTAL_RESOURCES, type Resource, type ResourceType } from '@/content/resources';
import { getLocalizedUrl } from '@/i18n/helpers';

const frRessourcesUrl = getLocalizedUrl('/ressources/', 'fr');

const typeLabelsEN: Record<ResourceType, string> = {
  'official-course': 'Official MIT course',
  'mit-sloan-article': 'MIT Sloan article',
  'mit-executive-article': 'MIT Executive Education article',
  'mit-ocw': 'MIT OpenCourseWare',
  'academic-paper': 'Academic publication',
  'standard': 'Standard / Regulation',
  'case-source': 'Case source (companies)',
  'external-resource': 'Verified external resource',
};

const typeDescriptionsEN: Record<ResourceType, string> = {
  'official-course': "Pages of the reference MIT Sloan program — non-affiliated reference for context.",
  'mit-sloan-article': "Articles MIT Sloan Management Review and Ideas Made to Matter.",
  'mit-executive-article': "Articles from MIT Sloan Executive Education and adjacent programs.",
  'mit-ocw': "MIT OpenCourseWare — free MIT courses on related topics.",
  'academic-paper': "Peer-reviewed academic papers and recognized working papers.",
  'standard': "Regulatory texts (EU AI Act, NIST, ISO, OECD).",
  'case-source': "Public communications from companies featured in case studies.",
  'external-resource': "Other reference sources verified by the editorial team.",
};

const orderedTypes: ResourceType[] = [
  'official-course', 'mit-sloan-article', 'mit-executive-article', 'mit-ocw',
  'academic-paper', 'standard', 'case-source', 'external-resource',
];

function groupByType(list: Resource[]): Record<ResourceType, Resource[]> {
  const grouped = {} as Record<ResourceType, Resource[]>;
  for (const t of orderedTypes) grouped[t] = [];
  for (const r of list) grouped[r.type].push(r);
  return grouped;
}

const grouped = groupByType(resources);
---

<BaseLayout
  title={`Resources — ${TOTAL_RESOURCES} verified references`}
  description={`Hub of ${TOTAL_RESOURCES} verified resources for AI strategy: MIT courses, MIT Sloan / MIT IDE articles, NIST AI RMF, EU AI Act, case sources.`}
>
  <HeroSecondary
    surtitle="Resources"
    title="Hub of verified references"
    lead={`${TOTAL_RESOURCES} verified references organized in 8 families. Each resource has its hierarchy level (official MIT, recommended complement, verifiable external source) and is publicly verifiable.`}
  >
    <span slot="stats">{TOTAL_RESOURCES} references · 8 families · publicly verifiable · sources hierarchized via SourceTag</span>
  </HeroSecondary>

  <div class="ai-container ai-resources-page">
    <article class="ai-prose">
      <section class="ai-resources-intro">
        <p>
          This hub gathers the {TOTAL_RESOURCES} reference resources used throughout the
          program. They are organized in 8 families: from MIT official sources to
          regulatory standards, via academic publications and case sources.
        </p>
        <p>
          Resource titles are kept in their original language (most are English by
          nature). Resource descriptions are in French in the
          <a href={frRessourcesUrl}>French version of this page</a>; on this English page,
          we display titles, types, and links — the brief descriptions are translated where
          they are essential for understanding context.
        </p>
      </section>

      {orderedTypes.map((type) => {
        const list = grouped[type];
        if (list.length === 0) return null;
        return (
          <section class="ai-resources-section">
            <header class="ai-resources-section__head">
              <h2>{typeLabelsEN[type]}</h2>
              <p>{typeDescriptionsEN[type]} <span class="ai-resources-section__count">({list.length} resource{list.length > 1 ? 's' : ''})</span></p>
            </header>
            <ul class="ai-resources-list">
              {list.map((r) => (
                <li class="ai-resources-item">
                  <a class="ai-resources-item__title" href={r.href} target="_blank" rel="noopener noreferrer">
                    {r.title}
                  </a>
                  {r.author && (
                    <span class="ai-resources-item__author"> · {r.author}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      <IndependenceNotice variant="block" />
    </article>
  </div>
</BaseLayout>

<style>
  .ai-resources-page { padding-block: var(--ai-space-7) var(--ai-space-8); }

  .ai-resources-intro {
    background: var(--ai-bg-subtle);
    padding: var(--ai-space-4);
    border-radius: var(--ai-radius-md);
    border-inline-start: 4px solid var(--ai-accent-primary);
    margin-block-end: var(--ai-space-7);
  }
  .ai-resources-intro p {
    margin-block: 0 var(--ai-space-3);
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
  }
  .ai-resources-intro p:last-child { margin-block-end: 0; }
  .ai-resources-intro a {
    color: var(--ai-accent-primary);
    font-weight: var(--ai-weight-semibold);
    text-decoration: none;
  }
  .ai-resources-intro a:hover { text-decoration: underline; }

  .ai-resources-section { margin-block: var(--ai-space-7); }
  .ai-resources-section__head {
    margin-block-end: var(--ai-space-4);
    padding-block-end: var(--ai-space-2);
    border-block-end: 2px solid var(--ai-accent-primary);
  }
  .ai-resources-section__head h2 {
    margin: 0 0 var(--ai-space-2);
    font-size: var(--ai-text-xl);
  }
  .ai-resources-section__head p {
    margin: 0;
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
    font-size: var(--ai-text-sm);
  }
  .ai-resources-section__count {
    color: var(--ai-fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .ai-resources-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--ai-space-2);
  }
  .ai-resources-item {
    padding: var(--ai-space-2) var(--ai-space-3);
    background: var(--ai-bg-base);
    border: 1px solid var(--ai-border-subtle);
    border-radius: var(--ai-radius-sm);
    line-height: var(--ai-leading-relaxed);
  }
  .ai-resources-item__title {
    color: var(--ai-fg-primary);
    text-decoration: none;
    font-weight: var(--ai-weight-semibold);
  }
  .ai-resources-item__title:hover {
    color: var(--ai-accent-primary);
    text-decoration: underline;
  }
  .ai-resources-item__author,
  .ai-resources-item__year {
    color: var(--ai-fg-muted);
    font-size: var(--ai-text-sm);
  }
</style>
