---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSecondary from '@/components/HeroSecondary.astro';
import StatsBar from '@/components/StatsBar.astro';
import IdentityTable from '@/components/IdentityTable.astro';
import ModulesTable from '@/components/ModulesTable.astro';
import OutcomesList from '@/components/OutcomesList.astro';
import BloomMatrix from '@/components/BloomMatrix.astro';
import CapstonePreview from '@/components/CapstonePreview.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import { getLocalizedUrl } from '@/i18n/helpers';
import { t } from '@/i18n/translations';

const locale = 'en';

const stats = [
  { value: '6', label: 'modules' },
  { value: '6–8 h', label: 'per week' },
  { value: '6', label: 'weeks' },
  { value: 'FR · EN · AR', label: 'trilingual' },
];

const identityRows = [
  { label: 'Reference institution', value: 'MIT Sloan School of Management + MIT CSAIL' },
  { label: 'Original format', value: '100% online, self-paced' },
  { label: 'Reference duration', value: '6 weeks excluding orientation' },
  { label: 'Workload', value: '6 to 8 hours per week' },
  { label: 'Positioning', value: 'Managerial and strategic — not technical' },
  { label: 'Reference project', value: "AI deployment plan for one's organization" },
  { label: 'Audience', value: 'Managers, executives, consultants, data, marketing and sales profiles' },
  { label: 'Technical prerequisites', value: 'None — no technical background assumed' },
];

const moduleRows = [
  { number: 1 as const, title: t('modules.module-1.title', locale), objective: 'Frame AI and collective intelligence.', href: getLocalizedUrl('/modules/01-introduction-ia/', locale), available: true },
  { number: 2 as const, title: t('modules.module-2.title', locale), objective: 'Decide when ML is relevant.', href: getLocalizedUrl('/modules/02-machine-learning/', locale), available: true },
  { number: 3 as const, title: t('modules.module-3.title', locale), objective: 'Decompose workflows and launch pilots.', href: getLocalizedUrl('/modules/03-ia-generative/', locale), available: true },
  { number: 4 as const, title: t('modules.module-4.title', locale), objective: 'Evaluate the relevance of physical automation.', href: getLocalizedUrl('/modules/04-robotique/', locale), available: true },
  { number: 5 as const, title: t('modules.module-5.title', locale), objective: 'Governance, ethics, compliance, work.', href: getLocalizedUrl('/modules/05-ia-societe/', locale), available: true },
  { number: 6 as const, title: t('modules.module-6.title', locale), objective: 'Build a credible AI roadmap.', href: getLocalizedUrl('/modules/06-futur-ia/', locale), available: true },
];

const outcomes = [
  "Explain the major families of AI (machine learning, generative AI, robotics) and their business implications.",
  "Judge the relevance of a Machine Learning use case for a cost, differentiation or focus strategy.",
  "Identify and prioritize generative AI use cases in an organization, and design a pilot.",
  "Evaluate when robotics creates value — and when it does not.",
  "Understand AI's impact on work, skills and society, and anticipate change management.",
  "Build an AI integration roadmap for an organization: diagnostic, prioritization, governance, KPIs.",
  "Engage with technical experts without being one yourself: ask the right questions, read a specification, interpret a result.",
];

const bloomRows = [
  { competency: "Understand the fundamental concepts of AI", bloomLevel: 'Understand', modules: [1, 2, 3, 4] as (1|2|3|4|5|6)[] },
  { competency: "Identify relevant AI use cases", bloomLevel: 'Apply', modules: [2, 3, 4] as (1|2|3|4|5|6)[] },
  { competency: 'Compare strategic options across AI families', bloomLevel: 'Analyze', modules: [2, 3, 4, 5] as (1|2|3|4|5|6)[] },
  { competency: 'Evaluate the relevance and ROI of an AI project', bloomLevel: 'Evaluate', modules: [2, 3, 4, 5] as (1|2|3|4|5|6)[] },
  { competency: 'Design an AI roadmap for an organization', bloomLevel: 'Create', modules: [6] as (1|2|3|4|5|6)[], capstone: true },
  { competency: 'Anticipate ethical and organizational impacts', bloomLevel: 'Evaluate', modules: [5, 6] as (1|2|3|4|5|6)[] },
];

const homeUrl = getLocalizedUrl('/', locale);
const modulesUrl = getLocalizedUrl('/modules/', locale);
const methodeUrl = getLocalizedUrl('/methode/', locale);
const module1Url = getLocalizedUrl('/modules/01-introduction-ia/', locale);

// Schema.org Course JSON-LD — describes the AI Strategy program.
const siteOrigin = (Astro.site?.toString() ?? 'https://ai-strategy.example.com').replace(/\/$/, '');
const courseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'AI Strategy — Pedagogical program inspired by MIT Sloan',
  description: 'A 6-module pedagogical program on artificial intelligence in business: machine learning, generative AI, robotics, governance and compliance, strategic roadmap. Inspired by the MIT Sloan program "Artificial Intelligence: Implications for Business Strategy".',
  provider: { '@id': `${siteOrigin}/#organization` },
  inLanguage: 'en',
  educationalLevel: 'professional',
  audience: {
    '@type': 'Audience',
    audienceType: 'Executives, managers, consultants, transformation leaders',
  },
  about: ['Artificial Intelligence', 'Business Strategy', 'Machine Learning', 'Generative AI', 'AI Governance', 'EU AI Act'],
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    inLanguage: 'en',
    courseWorkload: 'PT36H',
  },
  numberOfCredits: 0,
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by-nc-sa/4.0/',
};
const courseJsonLdString = JSON.stringify(courseJsonLd);
---

<BaseLayout
  title="The AI Strategy program — 6 modules in 6 weeks"
  description="6 modules, 6 weeks, in English: machine learning, generative AI, robotics, governance, roadmap. Inspired by the MIT Sloan program, independent and sourced."
>
  {/* === Schema.org Course JSON-LD for SEO === */}
  <script is:inline type="application/ld+json" slot="head" set:html={courseJsonLdString} />
  <HeroSecondary
    surtitle={t('site.surtitle', locale)}
    title="The program at a glance"
    lead="Six modules to decide, deploy and govern AI in your organization. A business-first approach, hierarchical sources, and assumed independence from the original program."
  />

  <section class="ai-container ai-section">
    <StatsBar stats={stats} />
  </section>

  <section class="ai-container ai-section">
    <h2 class="ai-section__title">Program identity</h2>
    <p class="ai-section__lead">
      The original program <em>Artificial Intelligence: Implications for Business Strategy</em>
      is offered by MIT Sloan School of Management and MIT Computer Science and Artificial
      Intelligence Laboratory. This site is inspired by it — without being a reproduction.
    </p>
    <IdentityTable rows={identityRows} caption="Publicly attested characteristics of the reference MIT Sloan program" />
    <div class="ai-section__notice">
      <IndependenceNotice variant="block" />
    </div>
  </section>

  <section class="ai-section--full">
    <div class="ai-container ai-section">
      <h2 class="ai-section__title">The six modules</h2>
      <p class="ai-section__lead">
        Six modules to be followed in order, or browsed by topic. Each module is built around
        an executive summary, an in-depth pedagogical content, and downloadable operational
        annexes (templates, checklists, PDF handouts).
      </p>
      <ModulesTable rows={moduleRows} />
    </div>
  </section>

  <section class="ai-container ai-section">
    <h2 class="ai-section__title">Seven cross-cutting learning outcomes</h2>
    <p class="ai-section__lead">
      At the end of the program, you should be able to perform the following seven actions
      autonomously. They form the implicit grid of self-assessment in each module.
    </p>
    <OutcomesList outcomes={outcomes} />
  </section>

  <section class="ai-section--full">
    <div class="ai-container ai-section">
      <h2 class="ai-section__title">Skills developed</h2>
      <p class="ai-section__lead">
        Mapping of the main skills against Bloom's taxonomy levels and the modules where
        they are mainly developed. The capstone consolidates the highest level — Create.
      </p>
      <BloomMatrix rows={bloomRows} />
    </div>
  </section>

  <section class="ai-container ai-section">
    <h2 class="ai-section__title">Pedagogical approach</h2>
    <div class="ai-pedagogy-grid">
      <div class="ai-pedagogy-block">
        <h3>Triple reading</h3>
        <p>
          Each module page works on three levels: <strong>executive summary</strong> (3-5
          minutes for the time-pressed executive), <strong>pedagogical content</strong> (25-45
          minutes for those who want to understand), <strong>downloadable operational annexes</strong>
          (templates, checklists, PDF handouts) for those who want to act.
        </p>
      </div>
      <div class="ai-pedagogy-block">
        <h3>Visible source hierarchy</h3>
        <p>
          Every factual claim is tagged with its level of evidence: official MIT source,
          MIT-related complement, pedagogical reconstruction, verifiable external source,
          or to be verified. You always know where each piece of information comes from.
          <a href={methodeUrl}>Learn more about the method →</a>
        </p>
      </div>
      <div class="ai-pedagogy-block">
        <h3>Multiformat media</h3>
        <p>
          Web pages written in dense prose, printable PDF handouts, narrative podcasts (Season 1
          in preparation), Mermaid diagrams, interactive quizzes with local persistence,
          trilingual glossary. You choose the format suited to your situation.
        </p>
      </div>
      <div class="ai-pedagogy-block">
        <h3>Capstone as a thread</h3>
        <p>
          The final project accompanies the learner throughout the program: in each module,
          questions for transposition to one's organization, and at the end of the program,
          a structured deliverable — the AI roadmap — usable in C-suite presentations or
          consulting engagements.
        </p>
      </div>
    </div>
  </section>

  <section class="ai-container ai-section ai-section--narrow">
    <CapstonePreview
      title="Build your organization's AI roadmap"
      description="At the end of the six modules, you produce a roadmap structured in 12 sections: maturity diagnostic, candidate use cases, prioritization, governance, budget, KPIs, risks, 12-24 month planning. Template included, pedagogical example, evaluation grid."
      ctaLabel="Discover the capstone"
    />
  </section>

  <section class="ai-container ai-section">
    <h2 class="ai-section__title">Frequently asked questions</h2>
    <div class="ai-faq-excerpt">
      <details class="ai-faq-item">
        <summary>Who is this site for?</summary>
        <p>
          For three audiences simultaneously: <strong>executives and top management</strong> who
          must frame an AI strategy at C-suite level; <strong>consultants and transformation leaders</strong>
          preparing an engagement; <strong>educators and students</strong> in management or
          information systems. Each page is readable by all three.
        </p>
      </details>
      <details class="ai-faq-item">
        <summary>Do I need a technical background in IT or data science?</summary>
        <p>
          <strong>No.</strong> The reference MIT program requires none, and this site follows that
          orientation. Technical concepts are explained <em>when they are necessary for managerial
          decision-making</em>, not as an end in themselves. You will not need to code Python to
          understand.
        </p>
      </details>
      <details class="ai-faq-item">
        <summary>How much time should I plan?</summary>
        <p>
          The MIT reference suggests 6 to 8 hours per week over 6 weeks. That's a benchmark, not
          an obligation. Many visitors come occasionally for a specific module or case. The
          executive summary of a module page reads in 3-5 minutes; the full page in 25-45 minutes.
        </p>
      </details>
      <details class="ai-faq-item">
        <summary>Is the site certified by MIT?</summary>
        <p>
          <strong>No, and this is explicit.</strong> This site is inspired by the public themes of
          the MIT Sloan program, but it is <strong>neither affiliated, validated, nor certified</strong>
          by MIT, MIT Sloan or MIT CSAIL. It is an independent pedagogical resource. See the
          <a href={methodeUrl}>Method page</a> for details.
        </p>
      </details>
      <details class="ai-faq-item">
        <summary>Can I download the content?</summary>
        <p>
          Yes. PDF handouts, templates and checklists are freely downloadable under CC BY-NC-SA 4.0
          license. You can use, modify and share them — provided you cite the source, do not make
          direct commercial use, and share under the same conditions. See the
          <a href={methodeUrl}>Method page</a> for concrete cases (consultants, educators, trainers).
        </p>
      </details>
    </div>
    <p class="ai-section__cta">
      <a href={getLocalizedUrl('/faq/', locale)}>See the full FAQ →</a>
    </p>
  </section>

  <section class="ai-container ai-section ai-section--cta">
    <h2 class="ai-section__title">Where to start?</h2>
    <div class="ai-cta-pair">
      <a class="ai-cta ai-cta--primary" href={module1Url}>
        Start with Module 1 →
      </a>
      <a class="ai-cta ai-cta--secondary" href={modulesUrl}>
        See all modules
      </a>
    </div>
    <p class="ai-cta-pair__note">
      <em>All six modules are now published in French. English versions are being progressively
      published in Phase 7. Meanwhile, you can explore the
      <a href={methodeUrl}>method</a>, the <a href={homeUrl}>overview</a>, or browse the
      documentation on GitHub.</em>
    </p>
  </section>
</BaseLayout>

<style>
  .ai-section { padding-block: var(--ai-space-7); }
  .ai-section--full { background: var(--ai-bg-subtle); }
  .ai-section--narrow { max-width: var(--ai-container-md); }
  .ai-section--cta { text-align: center; padding-block-end: var(--ai-space-9); }
  .ai-section__title { margin: 0 0 var(--ai-space-3); }
  .ai-section__lead { margin: 0 0 var(--ai-space-5); color: var(--ai-fg-secondary); font-size: var(--ai-text-lg); max-width: 65ch; line-height: var(--ai-leading-relaxed); }
  .ai-section__notice { margin-block-start: var(--ai-space-5); }
  .ai-section__cta { margin: var(--ai-space-5) 0 0; font-weight: var(--ai-weight-semibold); }
  .ai-section__cta a { color: var(--ai-accent-primary); text-decoration: none; }
  .ai-section__cta a:hover, .ai-section__cta a:focus-visible { text-decoration: underline; text-underline-offset: 0.2em; }

  .ai-pedagogy-grid { display: grid; gap: var(--ai-space-5); grid-template-columns: 1fr; }
  @media (min-width: 48em) { .ai-pedagogy-grid { grid-template-columns: repeat(2, 1fr); } }
  .ai-pedagogy-block h3 { margin: 0 0 var(--ai-space-2); font-size: var(--ai-text-lg); color: var(--ai-fg-primary); }
  .ai-pedagogy-block p { margin: 0; color: var(--ai-fg-secondary); line-height: var(--ai-leading-relaxed); }

  .ai-faq-excerpt { display: grid; gap: var(--ai-space-2); }
  .ai-faq-item { border: 1px solid var(--ai-border-subtle); border-radius: var(--ai-radius-md); background: var(--ai-bg-primary); overflow: hidden; }
  .ai-faq-item summary { padding: var(--ai-space-3) var(--ai-space-4); font-weight: var(--ai-weight-semibold); cursor: pointer; list-style: none; color: var(--ai-fg-primary); transition: background var(--ai-duration-fast) var(--ai-easing-default); }
  .ai-faq-item summary::-webkit-details-marker { display: none; }
  .ai-faq-item summary::before { content: '+'; display: inline-block; margin-inline-end: var(--ai-space-2); color: var(--ai-accent-primary); font-weight: var(--ai-weight-bold); transition: transform var(--ai-duration-fast) var(--ai-easing-default); }
  .ai-faq-item[open] summary::before { content: '−'; }
  .ai-faq-item summary:hover, .ai-faq-item summary:focus-visible { background: var(--ai-bg-subtle); }
  .ai-faq-item p { margin: 0; padding: 0 var(--ai-space-4) var(--ai-space-4); color: var(--ai-fg-secondary); line-height: var(--ai-leading-relaxed); }

  .ai-cta-pair { display: inline-flex; flex-wrap: wrap; gap: var(--ai-space-3); justify-content: center; margin-block: var(--ai-space-4); }
  .ai-cta-pair__note { margin: var(--ai-space-3) auto 0; color: var(--ai-fg-muted); font-size: var(--ai-text-sm); max-width: 60ch; }
  .ai-cta { display: inline-flex; align-items: center; gap: var(--ai-space-2); padding: var(--ai-space-3) var(--ai-space-5); border-radius: var(--ai-radius-md); font-weight: var(--ai-weight-semibold); text-decoration: none; }
  .ai-cta--primary { background: var(--ai-accent-primary); color: var(--ai-bg-primary); }
  .ai-cta--primary:hover, .ai-cta--primary:focus-visible { background: var(--ai-accent-hover); }
  .ai-cta--secondary { background: transparent; color: var(--ai-fg-primary); border: 1px solid var(--ai-border-default); }
  .ai-cta--secondary:hover, .ai-cta--secondary:focus-visible { background: var(--ai-bg-muted); }
</style>
