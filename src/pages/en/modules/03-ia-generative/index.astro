            id="quiz-module-3-en"
            title={quizModule3EN.title}
            intro={quizModule3EN.intro}
            questions={quizModule3EN.questions}
            scoringBands={quizModule3EN.scoringBands}
          />
        </section>

        {/* === § 8 — CHECKLIST === */}
        <section id="checklist">
          <h2>Manager checklist — GenAI framing</h2>
          <p>
            Twelve checkpoints before launching a GenAI pilot. Three groups: case framing,
            guardrails and compliance, economy and organization.
          </p>
          <Checklist
            id="checklist-module-3-en"
            title="GenAI framing — 12 checkpoints"
            intro="Before launching a GenAI pilot, go through these twelve points. Each checked box reinforces the defensibility of the case — guardrail points are non-negotiable for high-stakes uses."
            groups={checklistGroups}
          />
        </section>

        {/* === § 9 — APPLICATION === */}
        <section id="application">
          <h2>Application in your organization</h2>
          <p>
            Five questions to ask in your context. No universal right or wrong answer — what
            matters is being able to answer them <em>specifically</em> for your organization.
          </p>
          <ol class="ai-application-questions">
            <li>
              Identify 2 or 3 <strong>business workflows</strong> in your organization where
              GenAI could create value. For each, what is the most mechanical sub-task
              (automation candidate) and the most creative (to keep human)?
            </li>
            <li>
              For the most promising use case, what is the <strong>internal knowledge</strong>
              to mobilize via RAG? Is this knowledge accessible, up-to-date, and structured?
            </li>
            <li>
              What minimum <strong>guardrails</strong> (at least 5) do you plan from the pilot?
              What is the human escalation on sensitive cases?
            </li>
            <li>
              Have you calculated the pilot's <strong>total cost</strong> in 6 lines? Does the
              LLM subscription represent less than 30% of the total?
            </li>
            <li>
              What is the <strong>anticipated effect on the training pipeline</strong> of your
              organization (juniors, transmission of business knowledge) over 3-5 years?
            </li>
          </ol>

          <aside class="ai-application-aside">
            <h3>For consultants</h3>
            <p>
              In a GenAI framing engagement, these five questions structure a 3-hour workshop
              with an extended business team (CIO, business director, data team, compliance,
              HR). Participant diversity is crucial — GenAI decisions have transversal effects
              (regulatory, HR, technical) that no function alone can anticipate.
            </p>
          </aside>
        </section>

