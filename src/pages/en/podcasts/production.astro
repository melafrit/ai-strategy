---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSecondary from '@/components/HeroSecondary.astro';
import KeyTakeaways from '@/components/KeyTakeaways.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import PrintButton from '@/components/PrintButton.astro';
import { getLocalizedUrl } from '@/i18n/helpers';

const locale = 'en';

const transparencyPoints = [
  "The hosts' voices are synthetic, generated by NotebookLM — not humans speaking",
  "Content comes 100% from documentary sources loaded into NotebookLM — there is no human scriptwriter",
  "The human operator (the program author) prepares sources, writes focus notes, validates quality, but does not write the dialogue",
  "Each episode may produce a different result on each generation — variability is inherent to the format",
  "Episodes are reviewed and validated before publication using an 8-criteria quality grid",
  "If a factual claim is imprecise in a published episode, report it via GitHub repo: public, traceable correction",
];

const workflowSteps = [
  {
    num: 1,
    title: 'Source preparation',
    duration: '15-20 min',
    description:
      "For each episode, source pages of the site listed in the technical brief are printed via the print stylesheet (Phase 5 sub-3) into PDFs, then loaded into Google NotebookLM. Strict limit: 5 to 8 sources maximum, otherwise narrative quality decreases.",
  },
  {
    num: 2,
    title: "Custom instructions and generation launch",
    duration: '5-10 min',
    description:
      "The focus notes from the technical brief are injected into NotebookLM's 'Custom instructions' field, augmented by a universal template specifying language, audience, expected narrative structure, and constraints (no fabricated numbers, no fabricated studies, cite each source by full name).",
  },
  {
    num: 3,
    title: "Asynchronous generation",
    duration: '5-15 min',
    description:
      "NotebookLM generates an Audio Overview in the background. 'Deep Dive' format (2-host conversation), typical duration 12-18 minutes. During generation, sources must not be modified.",
  },
  {
    num: 4,
    title: "Critical listening and quality validation",
    duration: '15-20 min',
    description:
      "Each episode is listened to entirely with an 8-criteria grid: respected duration, no fabricated facts, concepts correctly used, embodied concrete case, no unsourced politically divisive claim, actionable conclusion, no excessive repetitions, reasonable anglicisms. If 3+ criteria fail, episode is regenerated (sometimes up to 3 times).",
  },
  {
    num: 5,
    title: 'Transcript and publication',
    duration: '30 min',
    description:
      "The validated MP3 is transcribed via OpenAI Whisper (large-v3) locally to produce a Markdown transcript structured by chapters. The MP3 and transcript are deposited in the repo and the episode status moves from `planned` to `published`. A traceable commit is pushed.",
  },
];

const qualityCriteria = [
  "Respected duration (between 80% and 120% of target)",
  "No fabricated facts: all company names, persons, numbers are in the sources",
  "Glossary concepts correctly used (no ML / GenAI / RAG / fine-tuning confusion)",
  "Concrete case present and embodied — episode does not stay on generalities",
  "No unsourced politically divisive claim",
  "Actionable conclusion: listener leaves with 2-3 concrete takes",
  "No excessive repetitions — dialogue format may paraphrase, not repeat",
  "Reasonable anglicisms — \"machine learning\" ok, \"delivery model leverage\" not",
];

const podcastsIndexUrl = getLocalizedUrl('/podcasts/', locale);
const methodeUrl = getLocalizedUrl('/methode/', locale);
---

<BaseLayout
  title="Podcast production — how are they made?"
  description="Transparency page on the production workflow of the 10 AI Strategy podcasts generated via Google NotebookLM. Source preparation, generation, quality validation, publication. How listeners can report errors."
>
  <HeroSecondary
    surtitle="Editorial transparency"
    title="How these podcasts are produced"
    lead="A transparency page for listeners: how each episode is generated, what the sources are, how quality is validated, how to report an error. Everything is public and traceable."
  >
    <span slot="stats">
      5-step workflow · 8-criteria quality grid · publicly verifiable sources
    </span>
  </HeroSecondary>

  <div class="ai-container ai-podcast-prod-page">
    <article class="ai-podcast-prod-page__content ai-prose">
      <section id="intro">
        <h2>Why this page exists</h2>
        <p>
          The 10 episodes of the <a href={podcastsIndexUrl}>AI Strategy series</a> are generated
          by Google NotebookLM. The voices are synthetic, the dialogue is automatically generated
          from documentary sources loaded into the notebook. This setup has a major advantage:
          it allows producing 10 pedagogical episodes in a short time. It also has limitations —
          result variability, non-human voices, potential factual imprecisions — that would be
          dishonest not to expose.
        </p>
        <p>
          This page publicly documents the <strong>production workflow</strong>: how sources are
          prepared, how generation is framed, how quality is validated, how a listener can report
          an error. The same information exists in a detailed technical version for contributors
          in <code>docs/podcasts/production-workflow.md</code> of the GitHub repo, and each
          episode has a brief sheet in <code>docs/podcasts/briefs/</code>.
        </p>
      </section>

      <section id="takeaways">
        <h2>Six transparency points</h2>
        <KeyTakeaways items={transparencyPoints} />
      </section>

      <section id="workflow">
        <h2>The 5-step workflow</h2>
        <p>
          Each episode follows the same process, taking approximately 1 hour to 1.5 hours
          depending on first-take quality. Denser episodes (Episode 7 capstone, Episode 10
          synthesis) often require an additional regeneration.
        </p>

        <ol class="ai-podcast-prod-steps">
          {workflowSteps.map((step) => (
            <li class="ai-podcast-prod-step">
              <header class="ai-podcast-prod-step__head">
                <span class="ai-podcast-prod-step__num">Step {step.num}</span>
                <h3>{step.title}</h3>
                <p class="ai-podcast-prod-step__duration">
                  Typical duration: {step.duration}
                </p>
              </header>
              <p class="ai-podcast-prod-step__body">{step.description}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="qualite">
        <h2>The quality grid (8 criteria)</h2>
        <p>
          Before publication, each episode is listened to in full and evaluated against 8
          criteria. If 3+ criteria fail, the episode is regenerated. This grid is itself the
          result of empirical observations: these are the 8 most frequent errors in NotebookLM
          generations.
        </p>
        <ol class="ai-podcast-prod-criteria">
          {qualityCriteria.map((c) => (
            <li>{c}</li>
          ))}
        </ol>
        <p class="ai-podcast-prod-note">
          <strong>Important note</strong> — the targeted quality is not "professional audio
          production". NotebookLM's synthetic voices have flaws (sometimes mechanical intonation,
          imperfect pronunciation of some technical terms). We accept these limits in exchange
          for the ability to produce 10 freely-accessible pedagogical episodes. If professional
          audio quality is essential for your use, read the written modules instead.
        </p>
      </section>

      <section id="report-error">
        <h2>How to report a factual error</h2>
        <p>
          If you identify an imprecise or erroneous factual claim in a published episode, report
          it via the <a
            href="https://github.com/melafrit/ai-strategy/issues"
            target="_blank"
            rel="noopener"
          >project's GitHub repo</a>. Specify:
        </p>
        <ul>
          <li>Episode number and slug (visible in URL)</li>
          <li>Approximate timestamp where the error is heard</li>
          <li>The error itself, and if possible the correct phrasing with its source</li>
        </ul>
        <p>
          Corrections are public and tracked in the CHANGELOG. Depending on severity, the episode
          may be regenerated and republished, or an erratum may be added at the end of the
          transcript.
        </p>
      </section>

      <section id="limits">
        <h2>Acknowledged limitations</h2>
        <p>
          Some honestly-acknowledged limits:
        </p>
        <ul>
          <li>
            <strong>Synthetic voices</strong> — the two AI hosts have neutral but recognizably
            non-human voices. Acceptable but to be flagged.
          </li>
          <li>
            <strong>Editorial stability</strong> — the same prompt may produce two quite
            different episodes. Manual validation partially compensates this variability.
          </li>
          <li>
            <strong>Google updates</strong> — NotebookLM evolves rapidly. The detailed workflow
            here is valid at writing time. If Google modifies interface or capabilities, the
            workflow will be updated, but older episodes may have been produced with slightly
            different parameters.
          </li>
          <li>
            <strong>Not an alternative course</strong> — the podcasts complement the site's
            reading experience. To go deep into concepts, cases and methodology, read the
            written modules. Any episode that significantly contradicts the site's written
            content will be revised.
          </li>
          <li>
            <strong>Not professional advice</strong> — episodes inform but do not substitute
            for a lawyer (for AI Act), strategy consultant (for the roadmap), or doctor (for
            health uses). Always verify with qualified professionals before any critical
            operational decision.
          </li>
        </ul>
      </section>

      <section id="links">
        <h2>Going further</h2>
        <ul>
          <li><a href={podcastsIndexUrl}>See all episodes</a> — the full series index</li>
          <li><a href={methodeUrl}>Method and source hierarchy</a> — how the site distinguishes its different confidence levels</li>
          <li>
            <a href="https://github.com/melafrit/ai-strategy" target="_blank" rel="noopener">
              GitHub repo
            </a> — source code, detailed documentation, error reporting
          </li>
          <li>
            <a href="https://notebooklm.google.com" target="_blank" rel="noopener">
              Google NotebookLM
            </a> — the tool used for generation
          </li>
        </ul>
      </section>

      <PrintButton />
      <IndependenceNotice variant="block" />
    </article>
  </div>
</BaseLayout>

<style>
  .ai-podcast-prod-page { padding-block: var(--ai-space-7) var(--ai-space-8); }
  .ai-podcast-prod-page__content > section {
    margin-block: var(--ai-space-7);
    scroll-margin-block-start: var(--ai-space-7);
  }

  .ai-podcast-prod-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--ai-space-4);
  }
  .ai-podcast-prod-step {
    padding: var(--ai-space-5);
    background: var(--ai-bg-base);
    border: 1px solid var(--ai-border-subtle);
    border-radius: var(--ai-radius-md);
    border-inline-start: 4px solid var(--ai-accent-primary);
  }
  .ai-podcast-prod-step__head { margin-block-end: var(--ai-space-3); }
  .ai-podcast-prod-step__num {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    background: var(--ai-accent-primary);
    color: var(--ai-bg-base);
    border-radius: var(--ai-radius-sm);
    font-size: var(--ai-text-xs);
    font-weight: var(--ai-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-block-end: var(--ai-space-2);
  }
  .ai-podcast-prod-step__head h3 {
    margin: var(--ai-space-1) 0 var(--ai-space-1);
    font-size: var(--ai-text-base);
    font-weight: var(--ai-weight-semibold);
    color: var(--ai-fg-primary);
  }
  .ai-podcast-prod-step__duration {
    margin: 0;
    font-size: var(--ai-text-sm);
    color: var(--ai-fg-muted);
  }
  .ai-podcast-prod-step__body {
    margin: 0;
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
  }

  .ai-podcast-prod-criteria {
    margin: var(--ai-space-3) 0;
    padding-inline-start: var(--ai-space-5);
    color: var(--ai-fg-secondary);
  }
  .ai-podcast-prod-criteria li {
    margin-block-end: var(--ai-space-2);
    line-height: var(--ai-leading-relaxed);
  }

  .ai-podcast-prod-note {
    padding: var(--ai-space-4);
    background: var(--ai-bg-subtle);
    border-radius: var(--ai-radius-md);
    border-inline-start: 3px solid var(--ai-accent-primary);
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
    margin-block: var(--ai-space-4);
  }
  .ai-podcast-prod-note strong { color: var(--ai-fg-primary); }
</style>
