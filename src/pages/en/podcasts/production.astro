---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TranslationPending from '@/components/TranslationPending.astro';
import { t } from '@/i18n/translations';

const locale = 'en';
---

<BaseLayout
  title={t('translation-pending.title', locale)}
  description="The English translation of the podcasts production page is scheduled for Phase 7. The French version is available now."
>
  <TranslationPending frenchPagePath="/podcasts/production/" />
</BaseLayout>
