---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSecondary from '@/components/HeroSecondary.astro';
import PodcastCard from '@/components/PodcastCard.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import {
  podcastsByTheme,
  podcastsByNumber,
  podcasts,
  countByTheme,
  TOTAL_PODCASTS,
  type PodcastTheme,
} from '@/content/podcasts';
import { getLocalizedUrl } from '@/i18n/helpers';

const locale = 'en';

const themesOrdered: PodcastTheme[] = [
  'foundations',
  'technology',
  'governance',
  'application',
];

// EN labels for podcast themes (the source data is FR-only for now)
const themeLabelsEN: Record<PodcastTheme, string> = {
  foundations: 'Foundations',
  technology: 'Technologies',
  governance: 'Governance and compliance',
  application: 'Cases and applications',
};

const themeDescriptionsEN: Record<PodcastTheme, string> = {
  foundations:
    "Strategic framing, conceptual foundations, decision methodology.",
  technology:
    "Technical AI families in business — supervised ML, GenAI, robotics.",
  governance:
    "EU AI Act, NIST RMF, OECD — how to navigate compliance without bureaucratizing.",
  application:
    "Exemplary cases, collective intelligence, impact on work, common pitfalls.",
};

const counts = countByTheme();

const statusCounts = {
  published: podcasts.filter((p) => p.status === 'published').length,
  inProduction: podcasts.filter((p) => p.status === 'in-production').length,
  planned: podcasts.filter((p) => p.status === 'planned').length,
};
const progressPct = Math.round((statusCounts.published / TOTAL_PODCASTS) * 100);

const methodeUrl = getLocalizedUrl('/methode/', locale);
const programmeUrl = getLocalizedUrl('/programme/', locale);
---

<BaseLayout
  title={`Podcasts — ${TOTAL_PODCASTS} narrative episodes around the program`}
  description={`Narrative series of ${TOTAL_PODCASTS} episodes on AI in business: foundations, technologies, governance, cases. Conversational format via Google NotebookLM.`}
>
  <HeroSecondary
    surtitle="Narrative series"
    title={`${TOTAL_PODCASTS} episodes to explore AI in business`}
    lead="A series of conversational podcasts revisiting the themes of the AI Strategy program in audio form. Four thematic families — foundations, technologies, governance, cases and applications — to listen to on the go, at the gym, or as a complement to your reading."
  >
    <span slot="stats">
      {TOTAL_PODCASTS} episodes · 4 themes · 12-18 min per episode · NotebookLM generation
    </span>
  </HeroSecondary>

  <div class="ai-container ai-podcasts-page">
    <section class="ai-podcasts-intro" aria-labelledby="intro-title">
      <h2 id="intro-title">Format and production</h2>
      <p>
        Each episode is a <strong>conversational "Audio Overview"</strong> generated by
        <a href="https://notebooklm.google.com" target="_blank" rel="noopener">Google NotebookLM</a>
        from the site's pages and complementary documentary sources. Two AI hosts explore the
        topic in a natural and accessible dialogue format — typical duration 12 to 18 minutes
        per episode.
      </p>
      <p>
        This series is <strong>not an alternative course</strong> but a complement for listening.
        To go deep into concepts, cases and methodology, read the
        <a href={programmeUrl}>modules</a> and study the
        <a href={getLocalizedUrl('/cas/', locale)}>case studies</a>. To skim or revise, listen to
        the podcasts.
      </p>
      <p class="ai-podcasts-intro__source-note">
        See the <a href={methodeUrl}>Method page</a> to understand how these podcasts are
        produced and the source hierarchy used in their editorial framing. For the production
        workflow detail (source preparation, NotebookLM generation, quality validation, error
        reporting), see the <a
          href={getLocalizedUrl('/podcasts/production/', locale)}
        >production page</a>.
      </p>
      <p class="ai-podcasts-intro__lang-note">
        <em>Note: episode pages are currently being translated. The episode briefs (sources,
        takeaways, prévisionnel chapters) are in French at this stage. Audio episodes will be
        produced in French first, then in English in a later phase.</em>
      </p>
    </section>

    <section class="ai-podcasts-progress" aria-labelledby="progress-title">
      <header class="ai-podcasts-progress__head">
        <h2 id="progress-title">Production status</h2>
        <span class="ai-podcasts-progress__pct">{progressPct}% published</span>
      </header>

      <div class="ai-podcasts-progress__bar" role="progressbar"
        aria-valuenow={statusCounts.published}
        aria-valuemin="0"
        aria-valuemax={TOTAL_PODCASTS}
        aria-label={`${statusCounts.published} episodes published out of ${TOTAL_PODCASTS}`}
      >
        <div
          class="ai-podcasts-progress__bar-fill"
          style={`width: ${progressPct}%`}
        ></div>
      </div>

      <ul class="ai-podcasts-progress__legend">
        <li class="ai-podcasts-progress__legend-item ai-podcasts-progress__legend-item--published">
          <span class="ai-podcasts-progress__dot" aria-hidden="true"></span>
          <strong>{statusCounts.published}</strong> {statusCounts.published === 1 ? 'episode published' : 'episodes published'}
        </li>
        <li class="ai-podcasts-progress__legend-item ai-podcasts-progress__legend-item--in-production">
          <span class="ai-podcasts-progress__dot" aria-hidden="true"></span>
          <strong>{statusCounts.inProduction}</strong> in production
        </li>
        <li class="ai-podcasts-progress__legend-item ai-podcasts-progress__legend-item--planned">
          <span class="ai-podcasts-progress__dot" aria-hidden="true"></span>
          <strong>{statusCounts.planned}</strong> planned
        </li>
      </ul>

      {statusCounts.published === 0 && (
        <p class="ai-podcasts-progress__note">
          The series is in editorial framing phase. The structured briefs of the 10 episodes are
          available below, and the <a
            href={getLocalizedUrl('/podcasts/production/', locale)}
          >production workflow</a> is documented publicly. The first episodes will be generated
          via Google NotebookLM in the coming weeks.
        </p>
      )}
    </section>

    <section class="ai-podcasts-themes-overview" aria-labelledby="themes-title">
      <h2 id="themes-title">Four themes</h2>
      <div class="ai-podcasts-themes-grid">
        {themesOrdered.map((theme) => (
          <a class="ai-podcasts-theme-card" href={`#theme-${theme}`}>
            <header class="ai-podcasts-theme-card__head">
              <h3>{themeLabelsEN[theme]}</h3>
              <span class="ai-podcasts-theme-card__count">
                {counts[theme]} {counts[theme] > 1 ? 'episodes' : 'episode'}
              </span>
            </header>
            <p>{themeDescriptionsEN[theme]}</p>
          </a>
        ))}
      </div>
    </section>

    {themesOrdered.map((theme) => {
      const list = podcastsByTheme(theme);
      if (list.length === 0) return null;
      return (
        <section
          id={`theme-${theme}`}
          class="ai-podcasts-section"
          aria-labelledby={`theme-${theme}-title`}
        >
          <header class="ai-podcasts-section__head">
            <h2 id={`theme-${theme}-title`}>{themeLabelsEN[theme]}</h2>
            <p>{themeDescriptionsEN[theme]}</p>
          </header>
          <div class="ai-podcasts-grid">
            {list.map((episode) => (
              <PodcastCard episode={episode} />
            ))}
          </div>
        </section>
      );
    })}

    <section class="ai-podcasts-series" aria-labelledby="series-title">
      <header class="ai-podcasts-section__head">
        <h2 id="series-title">Full series in recommended order</h2>
        <p>
          If you are discovering the program, the order of episodes 1 to 10 offers a natural
          progression: from strategic framing to HR implications, via technologies, governance,
          capstone methodology and a synthesis review.
        </p>
      </header>
      <ol class="ai-podcasts-series-list">
        {podcastsByNumber().map((episode) => (
          <li>
            <span class="ai-podcasts-series-num">
              {episode.number.toString().padStart(2, '0')}
            </span>
            <a
              href={getLocalizedUrl(`/podcasts/${episode.slug}/`, 'fr')}
              class="ai-podcasts-series-link"
            >
              <strong>{episode.title}</strong>
              <span class="ai-podcasts-series-subtitle">{episode.subtitle}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <div class="ai-podcasts-independence">
      <IndependenceNotice variant="block" />
    </div>
  </div>
</BaseLayout>

<style>
  .ai-podcasts-page { padding-block: var(--ai-space-7) var(--ai-space-8); }

  .ai-podcasts-intro {
    background: var(--ai-bg-subtle);
    padding: var(--ai-space-5);
    border-radius: var(--ai-radius-md);
    border-inline-start: 4px solid var(--ai-accent-primary);
    margin-block-end: var(--ai-space-7);
  }
  .ai-podcasts-intro h2 {
    margin: 0 0 var(--ai-space-3);
    font-size: var(--ai-text-lg);
    font-weight: var(--ai-weight-semibold);
    color: var(--ai-fg-primary);
  }
  .ai-podcasts-intro p {
    margin-block: 0 var(--ai-space-3);
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
  }
  .ai-podcasts-intro p:last-child { margin-block-end: 0; }
  .ai-podcasts-intro__source-note,
  .ai-podcasts-intro__lang-note {
    font-size: var(--ai-text-sm);
    color: var(--ai-fg-muted);
  }
  .ai-podcasts-intro a {
    color: var(--ai-accent-primary);
    text-decoration: none;
    font-weight: var(--ai-weight-semibold);
  }
  .ai-podcasts-intro a:hover { text-decoration: underline; }

  .ai-podcasts-progress {
    margin-block: var(--ai-space-7);
    padding: var(--ai-space-5);
    background: var(--ai-bg-base);
    border: 1px solid var(--ai-border-subtle);
    border-radius: var(--ai-radius-md);
  }
  .ai-podcasts-progress__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ai-space-3);
    margin-block-end: var(--ai-space-3);
  }
  .ai-podcasts-progress__head h2 {
    margin: 0;
    font-size: var(--ai-text-lg);
    font-weight: var(--ai-weight-semibold);
    color: var(--ai-fg-primary);
  }
  .ai-podcasts-progress__pct {
    font-variant-numeric: tabular-nums;
    color: var(--ai-accent-primary);
    font-weight: var(--ai-weight-bold);
    font-size: var(--ai-text-base);
  }
  .ai-podcasts-progress__bar {
    height: 0.5rem;
    background: var(--ai-bg-subtle);
    border-radius: 999px;
    overflow: hidden;
    margin-block-end: var(--ai-space-4);
  }
  .ai-podcasts-progress__bar-fill {
    height: 100%;
    background: var(--ai-accent-primary);
    transition: width 600ms ease;
  }
  .ai-podcasts-progress__legend {
    list-style: none;
    margin: 0 0 var(--ai-space-3);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ai-space-4);
  }
  .ai-podcasts-progress__legend-item {
    display: flex;
    align-items: center;
    gap: var(--ai-space-2);
    color: var(--ai-fg-secondary);
    font-size: var(--ai-text-sm);
  }
  .ai-podcasts-progress__legend-item strong {
    color: var(--ai-fg-primary);
    font-weight: var(--ai-weight-semibold);
    font-variant-numeric: tabular-nums;
  }
  .ai-podcasts-progress__dot {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--ai-border-subtle);
    flex-shrink: 0;
  }
  .ai-podcasts-progress__legend-item--published .ai-podcasts-progress__dot {
    background: color-mix(in srgb, #5a8c63 70%, transparent);
  }
  .ai-podcasts-progress__legend-item--in-production .ai-podcasts-progress__dot {
    background: color-mix(in srgb, #d4904a 70%, transparent);
  }
  .ai-podcasts-progress__legend-item--planned .ai-podcasts-progress__dot {
    background: var(--ai-fg-muted);
  }
  .ai-podcasts-progress__note {
    margin: 0;
    padding: var(--ai-space-3);
    background: var(--ai-bg-subtle);
    border-radius: var(--ai-radius-sm);
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
    font-size: var(--ai-text-sm);
  }
  .ai-podcasts-progress__note a {
    color: var(--ai-accent-primary);
    text-decoration: none;
    font-weight: var(--ai-weight-semibold);
  }
  .ai-podcasts-progress__note a:hover { text-decoration: underline; }

  .ai-podcasts-themes-overview { margin-block: var(--ai-space-7); }
  .ai-podcasts-themes-overview h2 {
    margin: 0 0 var(--ai-space-4);
    font-size: var(--ai-text-xl);
    font-weight: var(--ai-weight-semibold);
    color: var(--ai-fg-primary);
  }
  .ai-podcasts-themes-grid {
    display: grid;
    gap: var(--ai-space-3);
    grid-template-columns: 1fr;
  }
  @media (min-width: 50em) {
    .ai-podcasts-themes-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 80em) {
    .ai-podcasts-themes-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .ai-podcasts-theme-card {
    display: block;
    padding: var(--ai-space-4);
    background: var(--ai-bg-base);
    border: 1px solid var(--ai-border-subtle);
    border-radius: var(--ai-radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms ease, transform 120ms ease;
  }
  .ai-podcasts-theme-card:hover {
    border-color: var(--ai-accent-primary);
    transform: translateY(-1px);
  }
  .ai-podcasts-theme-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ai-space-2);
    margin-block-end: var(--ai-space-2);
  }
  .ai-podcasts-theme-card h3 {
    margin: 0;
    font-size: var(--ai-text-base);
    font-weight: var(--ai-weight-semibold);
    color: var(--ai-accent-primary);
  }
  .ai-podcasts-theme-card__count {
    font-size: var(--ai-text-xs);
    color: var(--ai-fg-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ai-podcasts-theme-card p {
    margin: 0;
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
    font-size: var(--ai-text-sm);
  }

  .ai-podcasts-section {
    margin-block: var(--ai-space-8);
    scroll-margin-block-start: var(--ai-space-7);
  }
  .ai-podcasts-section__head {
    border-block-end: 2px solid var(--ai-accent-primary);
    padding-block-end: var(--ai-space-3);
    margin-block-end: var(--ai-space-5);
  }
  .ai-podcasts-section__head h2 {
    margin: 0 0 var(--ai-space-1);
    font-size: var(--ai-text-2xl);
    font-weight: var(--ai-weight-bold);
    color: var(--ai-fg-primary);
  }
  .ai-podcasts-section__head p {
    margin: 0;
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
  }

  .ai-podcasts-grid {
    display: grid;
    gap: var(--ai-space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 50em) {
    .ai-podcasts-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .ai-podcasts-series-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--ai-space-3);
  }
  .ai-podcasts-series-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--ai-space-3);
    padding-block: var(--ai-space-2);
    border-block-end: 1px solid var(--ai-border-subtle);
  }
  .ai-podcasts-series-list li:last-child { border-block-end: none; }
  .ai-podcasts-series-num {
    font-variant-numeric: tabular-nums;
    color: var(--ai-accent-primary);
    font-weight: var(--ai-weight-bold);
    font-size: var(--ai-text-base);
    flex-shrink: 0;
    width: 2.5rem;
  }
  .ai-podcasts-series-link {
    flex: 1;
    color: inherit;
    text-decoration: none;
    line-height: var(--ai-leading-relaxed);
  }
  .ai-podcasts-series-link strong {
    display: block;
    color: var(--ai-fg-primary);
    font-weight: var(--ai-weight-semibold);
  }
  .ai-podcasts-series-link:hover strong {
    color: var(--ai-accent-primary);
    text-decoration: underline;
  }
  .ai-podcasts-series-subtitle {
    display: block;
    color: var(--ai-fg-secondary);
    font-size: var(--ai-text-sm);
    margin-block-start: 0.15rem;
  }

  .ai-podcasts-independence { margin-block: var(--ai-space-7); }
</style>
