---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSecondary from '@/components/HeroSecondary.astro';
import IndependenceNotice from '@/components/IndependenceNotice.astro';
import { getLocalizedUrl } from '@/i18n/helpers';

const locale = 'en';
const frFaqUrl = getLocalizedUrl('/faq/', 'fr');

interface FAQItem {
  question: string;
  answerHtml: string;
}

const sectionGeneral: FAQItem[] = [
  {
    question: "Is this an official MIT site?",
    answerHtml: `<p><strong>No.</strong> This site is neither affiliated, validated, nor certified by MIT, MIT Sloan, or MIT CSAIL. It is an independent pedagogical resource inspired by the public themes of the program <em>Artificial Intelligence: Implications for Business Strategy</em>. The independence is detailed in the <a href="${getLocalizedUrl('/methode/', locale)}">Method page</a>, section 2.</p>`,
  },
  {
    question: "Who is this site for?",
    answerHtml: `<p>For three audiences simultaneously: <strong>executives and top management</strong> who must frame an AI strategy at C-suite level; <strong>consultants and transformation leaders</strong> preparing an engagement; <strong>educators and students</strong> in management or information systems. Each page is readable by all three with its triple reading levels (executive summary / pedagogical content / operational annexes).</p>`,
  },
  {
    question: "Is this program certifying?",
    answerHtml: `<p><strong>No.</strong> The site does not deliver any certificate, diploma, or accreditation. It is a free pedagogical resource. If you are looking for an MIT-certified course, consult MIT Sloan Executive Education's official page directly. This site exists to provide a free, sourced, French-speaking and trilingual entry point — a different mission from a certifying program.</p>`,
  },
  {
    question: "How long does it take to go through the whole site?",
    answerHtml: `<p>It depends on your goals. <strong>Executive summary</strong> of one module: 3-5 minutes. <strong>Full module</strong>: 25-45 minutes. <strong>Module + associated case</strong>: 45-90 minutes. <strong>Full program</strong> (6 modules + 10 cases + capstone): 60-90 hours, depending on your starting maturity. The MIT reference suggests 6-8 hours per week over 6 weeks for the original program.</p>`,
  },
];

const sectionMethod: FAQItem[] = [
  {
    question: "How are cited sources hierarchized?",
    answerHtml: `<p>Five visible levels via the <code>&lt;SourceTag /&gt;</code> component: <strong>official MIT source</strong>, <strong>recommended complement</strong> (MIT-related), <strong>pedagogical reconstruction</strong>, <strong>verifiable external source</strong>, <strong>to verify</strong>. Every factual claim on the site is tagged. Detail in the <a href="${getLocalizedUrl('/methode/', locale)}">Method page</a>, section 1.</p>`,
  },
  {
    question: "What does 'pedagogical reconstruction' mean?",
    answerHtml: `<p>When information is not publicly detailed by MIT (for example, the exact nature of an assignment in a module, or a specific quote from a faculty), we cautiously reconstruct from public sources consistent with the spirit of the program. These reconstructions are <strong>always flagged as such</strong> and never presented as official. They allow filling gaps without falsifying.</p>`,
  },
];

const sectionStrategy: FAQItem[] = [
  {
    question: "How to choose a first AI use case for my organization?",
    answerHtml: `<p>Three criteria: <strong>(1) Visible business value</strong> — a metric the C-suite cares about (NPS, churn, fraud, time-to-decision, conversion). <strong>(2) Reasonable feasibility</strong> — data already available or producible, internal or external technical skills, governance acceptable. <strong>(3) Mastered risk</strong> — not in AI Act high-risk if your organization is not ready, not on the company's strategic crown jewel for first attempt.</p><p>Don't start with the most attractive case — start with the case that lets you <strong>build the team's collective capability</strong>: a credible test, a learning, and a base for the next ones.</p>`,
  },
  {
    question: "GenAI or classic supervised ML: when to choose which?",
    answerHtml: `<p>Simplified rule:</p><ul><li><strong>Supervised ML</strong> when you have <strong>labeled historical data</strong> and want to <strong>predict / classify / detect</strong>: fraud, churn, demand forecast, defect detection, credit scoring.</li><li><strong>GenAI</strong> when you want to <strong>produce content</strong> (text, image, code, summary) or <strong>conversationally interact</strong> with a corpus.</li></ul><p>Often, both are useful in different parts of the same workflow. Module 3, section 5, develops the decision matrix.</p>`,
  },
  {
    question: "Is my organization too small for AI?",
    answerHtml: `<p><strong>No.</strong> The threshold for credibly engaging with AI is no longer about data volume or large IT teams. With cloud APIs, no-code tools, and free open-source models, an SME of 20-50 people can deploy concrete AI. The right question is <strong>not 'can we'</strong> but <strong>'what use case really creates value for us'</strong>. Module 2 case Stripe Radar (large-scale ML) and Module 4 case Universal Robots (cobots for SMEs) illustrate the spectrum.</p>`,
  },
];

const sectionGovernance: FAQItem[] = [
  {
    question: "Am I concerned by the EU AI Act?",
    answerHtml: `<p>If you operate any AI system in the EU, <strong>most likely yes</strong>, regardless of your headquarters. The AI Act applies extraterritorially (like GDPR). Five obligations to assess in priority: <strong>(1)</strong> Inventory your AI systems. <strong>(2)</strong> Classify each (prohibited / high-risk / limited / minimal). <strong>(3)</strong> Document the systems for which classification implies obligations. <strong>(4)</strong> Set up a governance with management reporting. <strong>(5)</strong> Train concerned teams. The Module 5 case 'AI Act EU high-risk' details high-risk obligations.</p>`,
  },
  {
    question: "How to concretely articulate EU AI Act and NIST AI RMF?",
    answerHtml: `<p>Three principles: <strong>(1)</strong> AI Act = legal obligations (mandatory in EU), NIST RMF = operational method (voluntary worldwide, very valuable). <strong>(2)</strong> Use NIST RMF as <strong>internal process backbone</strong> (Govern / Map / Measure / Manage), and AI Act as <strong>compliance grid</strong> for high-risk uses. <strong>(3)</strong> Articulate with existing governances (cyber, audit, compliance) rather than create a separate AI silo. The Module 5 NIST AI RMF case develops this articulation.</p>`,
  },
  {
    question: "Should I create an AI ethics committee in my organization?",
    answerHtml: `<p>Yes for most organizations seriously deploying AI — but with an important framing: <strong>an AI ethics committee is not a moral body, it's an operational governance body</strong>.</p><p><strong>Bad version</strong>: a committee that publishes ethical principle charters and meets twice a year to validate that company values were respected. This serves no operational purpose.</p><p><strong>Good version</strong>: a committee that (a) classifies use cases per EU AI Act from the framing stage, (b) reviews technical documentation of high-risk systems before deployment, (c) tracks governance KPIs (bias audits, incidents, compliance), (d) can suspend a drifting system, (e) is consulted before any significant AI investment.</p><p><strong>Typical composition</strong>: CEO or executive direction (authority), CIO or technical direction, HR director (employment impact), CFO or compliance, lawyer/DPO, business representative, one referent per ongoing use case. For mature organizations, adding an external member (researcher, independent consultant) strengthens credibility. <strong>Articulate with existing governance</strong> (cyber, audit, compliance) rather than creating an AI silo.</p>`,
  },
  {
    question: "How to address the risk of algorithmic bias?",
    answerHtml: `<p>Algorithmic bias appears when an AI system produces systematically different results for subgroups (gender, origin, age) without legitimate business justification. Three main sources: bias in training data, design choices (proxy variables implicitly correlated with protected attributes), feedback loops.</p><p><strong>Detection</strong>: apply specific fairness metrics by subgroup from design phase, not downstream. Systematically test performance by sensitive subpopulation. A model that works very well on average can produce unacceptable decisions on minority subgroups.</p><p><strong>Mitigation</strong>: review training data composition, remove or neutralize problematic proxy variables, adjust decision threshold by subgroup when legally possible, set up reinforced human supervision on contested cases.</p><p><strong>Regulatory framework</strong>: the EU AI Act requires "data governance" (Article 10) including bias prevention and detection for high-risk systems. NIST AI RMF dedicates part of the Measure function to bias auditing. GDPR and anti-discrimination laws apply.</p><p><strong>Exemplary case</strong>: a CV screening system trained on historical recruitment data may learn to implicitly penalize female CVs even if gender is not an input variable — this is typical. A pre-deployment bias audit is non-negotiable on this type of use.</p>`,
  },
];

const sectionCapstone: FAQItem[] = [
  {
    question: "How long does it take to complete the capstone?",
    answerHtml: `<p>Duration depends on your ambition level and your organization's maturity. Three engagement levels:</p><p><strong>Short version (90-120 minutes)</strong> — fill out the Module 6 downloadable canvas autonomously. You get a synthetic one-page roadmap. Sufficient to structure your thinking and engage internal discussion.</p><p><strong>Medium version (1-2 days)</strong> — version usable in C-suite with methodological annexes (substantiated maturity diagnostic, V × F × R scoring of candidate use cases with justifications, detailed action plan across 5 dimensions, estimated budget, major risks mapping). Sufficient for a validation call by executive direction.</p><p><strong>Complete version (2-3 weeks)</strong> — in team workshop mode with internal validation. Implies 2-3 collective work sessions, interviews with concerned business directions, EU AI Act compliance analysis, preliminary social partner consultation if applicable. Sufficient for an operational launch.</p><p>The 7-dimension × 4-level evaluation grid in the capstone page allows assessing achieved quality. A "Solid" score on 5 dimensions and "Excellent" on 2 marks the C-suite defendability threshold.</p>`,
  },
  {
    question: "Is the capstone suitable for all organization sizes?",
    answerHtml: `<p>Yes — methodology is invariant by size, but deliverable scope and budget orders of magnitude adapt.</p><p><strong>For an SME (50-300 employees)</strong> — simplified diagnostic, 1-2 priority use cases, lightweight governance (a reduced committee suffices), typical budget €200-500k over 18 months. The fictional Métallurgie de Précision SAS example in the capstone page illustrates this ambition level.</p><p><strong>For a mid-cap or large group</strong> — more formal diagnostic, 5-10 prioritized use cases in portfolio, structured governance (AI committee + project leads per use case), multi-year 7-figure budget, articulation with group strategy. The canvas remains applicable but with more iterations between steps.</p><p><strong>For a public administration</strong> — adaptation needed on the AI Act dimension (essential public services = high-risk by default), strong social partner involvement from framing stage, articulation with administrative transparency obligations.</p><p><strong>For a very small organization (small business, association)</strong> — the canvas's short version (90-120 min) is appropriate. Focus on 1 clear and well-bounded use case. No need to produce a 50-page deliverable.</p>`,
  },
  {
    question: "What level of expertise is needed before tackling the capstone?",
    answerHtml: `<p>The capstone is designed to be achievable by an executive, manager, or consultant <strong>without prior technical expertise</strong>. This is consistent with the program's business-first positioning.</p><p><strong>Minimum prerequisites</strong> — having gone through at least modules 1 (Introduction), 5 (AI and society), and 6 (Future of AI). Ideally all 6 modules. Having basic information about your organization's strategic context (objectives, constraints, approximate resources).</p><p><strong>What helps</strong> — knowing the current AI situation in your organization (do projects already exist? a data team? deployed tools?), having a sponsor in executive direction, having at least a few hours to collect information from concerned business directions.</p><p><strong>What is not needed</strong> — knowing how to program in Python, understanding transformer technical details, having trained an ML model, mastering optimization mathematics. The capstone focuses on strategic framing, not implementation.</p><p><strong>For very technical profiles</strong> (data scientist, ML engineer) — the capstone may seem insufficiently technical. This is intentional: the challenge for you will be articulating your technical skills with a governance and strategy decision. Modules 5 and 6 and the 7-dimension evaluation grid will help.</p>`,
  },
];

const sectionPractical: FAQItem[] = [
  {
    question: "In what order should I go through the 6 modules?",
    answerHtml: `<p>Numerical order (Module 1 → 2 → 3 → 4 → 5 → 6) is recommended for those discovering the topic. Each module prepares the next: Module 1 lays conceptual foundations, Module 6 consolidates into a roadmap.</p><p><strong>For more advanced profiles</strong>, alternative paths are possible:</p><p><strong>"Governance-first" path</strong> (useful for compliance leaders, lawyers, DPOs) — Module 1 → Module 5 → Module 6 → then Modules 2-3-4 according to priority uses.</p><p><strong>"Technical-first" path</strong> (useful for data scientists who must rise in governance) — Modules 2-3-4 first to articulate what they already do with business framing, then Modules 5-6 for the strategic dimension.</p><p><strong>"Use case" path</strong> (useful for business managers) — start from the 10 case studies that concern them (by sector or by technology), return to associated modules as needed, finish with the capstone.</p><p><strong>The capstone</strong> remains the recommended endpoint in all cases. It integrates all concepts and forces articulating what was understood into concrete decisions for the organization.</p>`,
  },
  {
    question: "When will the English and Arabic versions be available?",
    answerHtml: `<p>The English (EN) and Arabic (AR) versions are largely available now. As of the most recent CHANGELOG update: <strong>EN parity is essentially complete</strong> for the 6 modules, the 10 cases, the capstone, the FAQ, the glossary, and all overview pages. <strong>AR parity is partial</strong>: the structural pages (FAQ, glossary, methodology, program, resources, etc.) are translated; deep content pages (modules, cases, capstone) currently display "Translation pending" notices for Arabic with links to French equivalents.</p><p><strong>Why this delay on AR deep content?</strong> Quality professional Arabic translation of long technical content takes time. Producing it via machine translation would be lower quality and could mislead readers. We prefer to signal explicitly what is and isn't translated.</p><p><strong>If you read Arabic or English</strong> and want to help accelerate translations — feel free to contribute via the GitHub repo. Source files are in <code>src/pages/{en,ar}/</code> and <code>src/i18n/translations.ts</code>. Any serious contribution will be integrated and credited.</p>`,
  },
  {
    question: "Is the content regularly updated? Can I reuse it?",
    answerHtml: `<p><strong>Updates</strong> — the site evolves regularly. Evolutions are tracked in the CHANGELOG on GitHub with dates and version numbers. Content is sensitive to regulatory evolutions (notably EU AI Act) and technological evolutions (new foundation models, ecosystem evolutions); we update according to our availability.</p><p><strong>Pedagogical reuse</strong> — content is under <strong>Creative Commons BY-NC-SA 4.0</strong> license. You can:</p><p><strong>Reuse freely</strong> in training, higher education, corporate academy, provided you (a) <em>cite the source</em> (link to site and license), (b) <em>preserve conditions</em> (BY-NC-SA), (c) <em>do not use it for direct commercial purposes</em> (selling content as is).</p><p><strong>Adapt and modify</strong> while keeping the license on derivative work. If you correct an error or add useful content, you are welcome to contribute back via the GitHub repo.</p><p><strong>Do not confuse with the official MIT program</strong> — the license covers only content produced for this site, not MIT works we cite (which remain under their own licenses).</p><p>For direct commercial uses (integration into a paid product, for example), contact us via GitHub to discuss a specific license.</p>`,
  },
];

const sectionMethodExt: FAQItem[] = [
  ...sectionMethod,
  {
    question: "How do you guarantee source reliability?",
    answerHtml: `<p>Three operational principles:</p><p><strong>Public sources only</strong> — every cited resource is freely accessible by anyone, at the indicated URL. No private citations, no "according to internal sources", no unverifiable claims.</p><p><strong>Source level signaled</strong> — the source hierarchy (official MIT / recommended complement / verifiable external source / pedagogical reconstruction) lets the reader calibrate the confidence given to each claim.</p><p><strong>No invented factual information</strong> — no approximate numbers presented as exact, no quotes attributed without source, no invented studies. When a number is not publicly documented with precision, we indicate the order of magnitude and source, or we abstain.</p><p>That said, the site remains an independent production: we remain fallible. If you identify a factual error, signal it via the GitHub repo. Corrections are public and tracked in the CHANGELOG.</p>`,
  },
];

const allSections = [
  { title: 'About this site', items: sectionGeneral },
  { title: 'Method and sources', items: sectionMethodExt },
  { title: 'AI strategy in business', items: sectionStrategy },
  { title: 'Governance and compliance', items: sectionGovernance },
  { title: 'Capstone and roadmap', items: sectionCapstone },
  { title: 'Practical course', items: sectionPractical },
];

const totalQuestionsThisPage = allSections.reduce((sum, s) => sum + s.items.length, 0);
---

<BaseLayout
  title="Frequently asked questions"
  description="FAQ on AI Strategy: site identity, method, AI in business, governance and AI Act EU, capstone. Sourced answers with cross-references."
>
  <HeroSecondary
    surtitle="FAQ"
    title="Frequently asked questions"
    lead={`${totalQuestionsThisPage} key questions answered, organized into 6 thematic sections. Each answer points to the in-depth content on the site.`}
  >
    <span slot="stats">
      {totalQuestionsThisPage} key questions in English · full parity with the French version · structured answers · public sources
    </span>
  </HeroSecondary>

  <div class="ai-container ai-faq-page">
    <article class="ai-faq-page__content ai-prose">
      <section class="ai-faq-intro">
        <p>
          This FAQ gathers the most frequent questions about the site, the program, and AI
          strategy in business. The English version is now at <strong>full parity with the
          French version</strong>: 20 questions across 6 thematic sections, including specialized
          ones (capstone duration, capstone for all sizes, expertise required, module order,
          translation status, content reuse).
        </p>
        <p class="ai-faq-page__fr-link">
          See also the <a href={frFaqUrl}>French version</a>, or open an issue on
          <a href="https://github.com/melafrit/ai-strategy/issues" target="_blank" rel="noopener">GitHub</a>
          if your question isn't covered.
        </p>
      </section>

      {allSections.map((section) => (
        <section class="ai-faq-section">
          <h2>{section.title}</h2>
          <div class="ai-faq-list">
            {section.items.map((item) => (
              <details class="ai-faq-item">
                <summary class="ai-faq-item__question">{item.question}</summary>
                <div class="ai-faq-item__answer" set:html={item.answerHtml} />
              </details>
            ))}
          </div>
        </section>
      ))}

      <IndependenceNotice variant="block" />
    </article>
  </div>
</BaseLayout>

<style>
  .ai-faq-page { padding-block: var(--ai-space-7) var(--ai-space-8); }
  .ai-faq-page__content > section { margin-block: var(--ai-space-6); }
  .ai-faq-intro {
    background: var(--ai-bg-subtle);
    padding: var(--ai-space-4);
    border-radius: var(--ai-radius-md);
    border-inline-start: 4px solid var(--ai-accent-primary);
  }
  .ai-faq-intro p { margin-block: 0 var(--ai-space-2); color: var(--ai-fg-secondary); line-height: var(--ai-leading-relaxed); }
  .ai-faq-intro p:last-child { margin-block-end: 0; }
  .ai-faq-page__fr-link { font-size: var(--ai-text-sm); color: var(--ai-fg-muted); }
  .ai-faq-page__fr-link a { color: var(--ai-accent-primary); font-weight: var(--ai-weight-semibold); text-decoration: none; }
  .ai-faq-page__fr-link a:hover { text-decoration: underline; }

  .ai-faq-section h2 {
    font-size: var(--ai-text-xl);
    margin: 0 0 var(--ai-space-4);
    padding-block-end: var(--ai-space-2);
    border-block-end: 2px solid var(--ai-accent-primary);
  }
  .ai-faq-list { display: grid; gap: var(--ai-space-2); }
  .ai-faq-item {
    border: 1px solid var(--ai-border-subtle);
    border-radius: var(--ai-radius-md);
    background: var(--ai-bg-base);
    overflow: hidden;
  }
  .ai-faq-item__question {
    padding: var(--ai-space-3) var(--ai-space-4);
    font-weight: var(--ai-weight-semibold);
    cursor: pointer;
    list-style: none;
    color: var(--ai-fg-primary);
  }
  .ai-faq-item__question::-webkit-details-marker { display: none; }
  .ai-faq-item__question::before {
    content: '+';
    display: inline-block;
    margin-inline-end: var(--ai-space-2);
    color: var(--ai-accent-primary);
    font-weight: var(--ai-weight-bold);
  }
  .ai-faq-item[open] .ai-faq-item__question::before { content: '−'; }
  .ai-faq-item__question:hover { background: var(--ai-bg-subtle); }
  .ai-faq-item__answer {
    padding: 0 var(--ai-space-4) var(--ai-space-4);
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
  }
  .ai-faq-item__answer :global(p) { margin: 0 0 var(--ai-space-3); }
  .ai-faq-item__answer :global(p:last-child) { margin-block-end: 0; }
  .ai-faq-item__answer :global(ul) { margin: 0 0 var(--ai-space-3); padding-inline-start: var(--ai-space-5); }
  .ai-faq-item__answer :global(li) { margin-block: var(--ai-space-1); }
  .ai-faq-item__answer :global(a) { color: var(--ai-accent-primary); text-decoration: none; font-weight: var(--ai-weight-semibold); }
  .ai-faq-item__answer :global(a:hover) { text-decoration: underline; }
  .ai-faq-item__answer :global(code) {
    background: var(--ai-bg-subtle);
    padding: 0 0.3em;
    border-radius: var(--ai-radius-sm);
    font-family: var(--ai-font-mono);
    font-size: 0.9em;
  }
</style>
