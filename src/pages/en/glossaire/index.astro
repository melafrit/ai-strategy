  /** Term as displayed in the title */
  termEN: string;
  /** FR term for cross-reference */
  termFR: string;
  /** Thematic category */
  category: 'fundamentals' | 'ml' | 'genai' | 'robotics' | 'governance' | 'methodology';
  /** Short one-sentence definition shown in the list */
  shortDef: string;
  /** Full definition, 2-3 paragraphs — shown when entry is expanded */
  longDef: string;
  /** Concrete business example — shown when entry is expanded */
  example?: string;
}

const terms: Term[] = [
  // ========================================================================
  // FUNDAMENTALS (5)
