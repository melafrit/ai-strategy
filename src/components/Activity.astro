---
/**
 * Activity.astro — bloc activité pratique guidée.
 *
 * Structure : titre + estimation de durée + liste d'étapes ordonnées +
 * critères d'évaluation simples + lien vers template/canvas téléchargeable
 * (optionnel).
 *
 * Format orienté pratique — l'activité doit être réalisable en 30-60 min
 * en autonomie ou en atelier.
 */

interface ActivityStep {
  /** Step heading (translated). */
  heading: string;
  /** Step body (translated, plain text or simple inline markup). */
  body: string;
}

interface Props {
  /** Anchor id (kebab-case). */
  id?: string;
  /** Activity title. */
  title: string;
  /** Time estimate, e.g. "30-45 min". */
  duration: string;
  /** Difficulty level (translated). */
  level?: string;
  /** Ordered list of steps. */
  steps: ActivityStep[];
  /** Evaluation criteria (translated, plain text). */
  criteria?: string[];
  /** Optional download link to a template/canvas. */
  downloadLabel?: string;
  downloadHref?: string;
  className?: string;
}

const {
  id,
  title,
  duration,
  level,
  steps,
  criteria,
  downloadLabel,
  downloadHref,
  className,
} = Astro.props;
---

<section class:list={['ai-activity', className]} id={id}>
  <header class="ai-activity__header">
    <span class="ai-activity__icon" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
      </svg>
    </span>
    <div class="ai-activity__heading-block">
      <h3 class="ai-activity__title">{title}</h3>
      <p class="ai-activity__meta">
        <span>⏱ {duration}</span>
        {level && <span>· {level}</span>}
      </p>
    </div>
  </header>

  <div class="ai-activity__body">
    <ol class="ai-activity__steps">
      {
        steps.map((step) => (
          <li class="ai-activity__step">
            <h4>{step.heading}</h4>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

    {criteria && criteria.length > 0 && (
      <div class="ai-activity__criteria">
        <h4>Critères d'évaluation</h4>
        <ul>
          {criteria.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    )}

    {downloadHref && downloadLabel && (
      <p class="ai-activity__download">
        <a href={downloadHref} rel="noopener noreferrer">
          ⬇ {downloadLabel}
        </a>
      </p>
    )}
  </div>
</section>

<style>
  .ai-activity {
    padding: var(--ai-space-5);
    background: var(--ai-bg-subtle);
    border: 1px solid var(--ai-border-subtle);
    border-radius: var(--ai-radius-md);
    margin-block: var(--ai-space-4);
    scroll-margin-block-start: var(--ai-space-7);
  }

  .ai-activity__header {
    display: flex;
    align-items: flex-start;
    gap: var(--ai-space-3);
    margin-block-end: var(--ai-space-4);
  }

  .ai-activity__icon {
    color: var(--ai-accent-primary);
    flex-shrink: 0;
    margin-block-start: 0.15em;
  }

  .ai-activity__heading-block {
    flex: 1;
    min-width: 0;
  }

  .ai-activity__title {
    margin: 0 0 var(--ai-space-1);
    font-size: var(--ai-text-xl);
    font-weight: var(--ai-weight-semibold);
  }

  .ai-activity__meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ai-space-2);
    color: var(--ai-fg-muted);
    font-size: var(--ai-text-sm);
  }

  .ai-activity__steps {
    margin: 0;
    padding-inline-start: var(--ai-space-5);
    display: grid;
    gap: var(--ai-space-3);
  }

  .ai-activity__step h4 {
    margin: 0 0 var(--ai-space-1);
    font-size: var(--ai-text-base);
    font-weight: var(--ai-weight-semibold);
    color: var(--ai-fg-primary);
  }
  .ai-activity__step p {
    margin: 0;
    color: var(--ai-fg-secondary);
    line-height: var(--ai-leading-relaxed);
  }

  .ai-activity__criteria {
    margin-block-start: var(--ai-space-5);
    padding: var(--ai-space-3) var(--ai-space-4);
    background: var(--ai-bg-primary);
    border: 1px solid var(--ai-border-subtle);
    border-radius: var(--ai-radius-sm);
  }
  .ai-activity__criteria h4 {
    margin: 0 0 var(--ai-space-2);
    font-size: var(--ai-text-sm);
    font-weight: var(--ai-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--ai-tracking-wide);
    color: var(--ai-fg-secondary);
  }
  :global([dir='rtl']) .ai-activity__criteria h4 {
    text-transform: none;
    letter-spacing: 0;
  }
  .ai-activity__criteria ul {
    margin: 0;
    padding-inline-start: var(--ai-space-5);
    color: var(--ai-fg-primary);
  }
  .ai-activity__criteria li {
    margin-block: var(--ai-space-1);
    line-height: var(--ai-leading-relaxed);
  }

  .ai-activity__download {
    margin: var(--ai-space-4) 0 0;
    padding: var(--ai-space-3) var(--ai-space-4);
    background: var(--ai-bg-primary);
    border: 1px dashed var(--ai-border-default);
    border-radius: var(--ai-radius-sm);
    color: var(--ai-accent-primary);
    font-weight: var(--ai-weight-semibold);
  }
  .ai-activity__download a {
    color: inherit;
    text-decoration: none;
  }
  .ai-activity__download a:hover,
  .ai-activity__download a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
