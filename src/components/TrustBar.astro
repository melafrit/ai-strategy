---
/**
 * TrustBar.astro — proof bar shown on the home page.
 *
 * Four credibility markers displayed in a row (stacked on mobile):
 *   1. Independence from MIT
 *   2. Hierarchical sources
 *   3. Trilingual (FR · EN · AR)
 *   4. Open license (CC BY-NC-SA 4.0)
 */

import { getLocaleFromPath, getLocalizedUrl } from '@/i18n/helpers';
import { t } from '@/i18n/translations';

const pathname = Astro.url.pathname;
const locale = getLocaleFromPath(pathname);
const methodHref = getLocalizedUrl('/methode/', locale);

interface TrustItem {
  icon: 'shield-off' | 'badge-check' | 'globe' | 'unlock';
  label: string;
  href?: string;
}

const items: TrustItem[] = [
  {
    icon: 'shield-off',
    label: t('trust.independence', locale),
    href: methodHref,
  },
  {
    icon: 'badge-check',
    label: t('trust.sources', locale),
    href: methodHref,
  },
  {
    icon: 'globe',
    label: t('trust.trilingual', locale),
  },
  {
    icon: 'unlock',
    label: t('trust.licence', locale),
  },
];
---

<aside class="ai-trustbar" aria-label="Repères de confiance">
  <div class="ai-container ai-trustbar__inner">
    <ul class="ai-trustbar__list">
      {
        items.map((item) => (
          <li class="ai-trustbar__item">
            <span class="ai-trustbar__icon" aria-hidden="true">
              {item.icon === 'shield-off' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M19.7 14a6.9 6.9 0 0 0 .3-2V5l-8-3-3.2 1.2" />
                  <path d="M4.7 6.7 4 5v7c0 6 8 10 8 10a20.3 20.3 0 0 0 5.6-4.4" />
                  <line x1="2" y1="2" x2="22" y2="22" />
                </svg>
              )}
              {item.icon === 'badge-check' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              )}
              {item.icon === 'globe' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                  <path d="M2 12h20" />
                </svg>
              )}
              {item.icon === 'unlock' && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                  <path d="M7 11V7a5 5 0 0 1 9.9-1" />
                </svg>
              )}
            </span>
            {item.href ? (
              <a href={item.href} class="ai-trustbar__label">
                {item.label}
              </a>
            ) : (
              <span class="ai-trustbar__label">{item.label}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<style>
  .ai-trustbar {
    background: var(--ai-bg-subtle);
    border-block: 1px solid var(--ai-border-subtle);
  }

  .ai-trustbar__inner {
    padding-block: var(--ai-space-4);
  }

  .ai-trustbar__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--ai-space-3) var(--ai-space-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 48em) {
    .ai-trustbar__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ai-trustbar__item {
    display: flex;
    align-items: center;
    gap: var(--ai-space-2);
  }

  .ai-trustbar__icon {
    color: var(--ai-accent-primary);
    flex-shrink: 0;
  }

  .ai-trustbar__label {
    font-size: var(--ai-text-sm);
    font-weight: var(--ai-weight-medium);
    color: var(--ai-fg-secondary);
  }
  a.ai-trustbar__label {
    text-decoration: none;
  }
  a.ai-trustbar__label:hover,
  a.ai-trustbar__label:focus-visible {
    color: var(--ai-accent-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
