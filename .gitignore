# =========================================================
# .gitignore — ai-strategy
# Conçu pour un projet Astro avec scripts et tooling
# =========================================================

# Dépendances Node
node_modules/
.pnpm-store/
.pnpm-debug.log*
package-lock.json.bak

# Astro
dist/
.astro/
.output/

# Tooling et caches
.cache/
.turbo/
.parcel-cache/
.next/

# Variables d'environnement (jamais committer)
.env
.env.local
.env.production
.env.development
.env.*.local
*.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editeurs et IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# Système
.DS_Store
Thumbs.db
desktop.ini

# Fichiers temporaires de build local
tmp/
temp/
.tmp/
.temp/

# PDFs générés en local (ils seront dans /public/fiches/ une fois finaux)
build/pdf-drafts/

# Médias en cours (avant import dans /public/)
work/medias-bruts/
work/notebooklm-exports/

# Artefacts de tests
coverage/
.nyc_output/
*.lcov

# Secrets et tokens — ne jamais committer
secrets/
*.token
*.pem
.npmrc.local
